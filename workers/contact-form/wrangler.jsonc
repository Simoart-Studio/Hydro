// Contact form Worker. Deployed by Cloudflare Workers Builds from this folder (root directory: workers/contact-form).
// Needs Email Routing on hydrokotly.pl with TO_ADDRESS verified as a destination address.
{
  "name": "hydro-formularz",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "formularz.hydrokotly.pl", "custom_domain": true }],
  // Counted per Cloudflare location; limits per 60 s. A person sends one form, maybe a second after a mistake.
  "ratelimits": [
    { "name": "LIMIT_VISITOR", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "LIMIT_TOTAL", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
  ],
  "send_email": [{ "name": "MAIL", "destination_address": "hydrokotlownie@gmail.com" }],
  "vars": {
    "ALLOWED_ORIGINS": "https://hydrokotly.pl",
    "FROM_ADDRESS": "formularz@hydrokotly.pl",
    "TO_ADDRESS": "hydrokotlownie@gmail.com",
  },
  "observability": { "enabled": true },
}
