---
import Container from "../components/Container.astro";
import CtaBand from "../components/CtaBand.astro";
import Gallery from "../components/Gallery.astro";
import PageHeader from "../components/PageHeader.astro";
import { galleryGroups } from "../content/gallery";
import { projectsPage } from "../content/projects";
import { site } from "../content/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title={`${projectsPage.metaTitle} | ${site.brandLines[0]}`}
  description={projectsPage.lead}
  breadcrumb={projectsPage.title}
>
  <PageHeader title={projectsPage.title} lead={projectsPage.lead} />
  <Container width="page">
    <nav class="jump" aria-label={projectsPage.groupsLabel}>
      <ul role="list">
        {galleryGroups.map((group) => (
          <li>
            <a href={`#${group.id}`}>
              {group.title}
              <span class="count">{group.photos.length}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    {galleryGroups.map((group) => (
      <section id={group.id} class="group" aria-labelledby={`${group.id}-title`}>
        <div class="heading">
          <h2 id={`${group.id}-title`}>{group.title}</h2>
          <p>{group.description}</p>
        </div>
        <Gallery photos={group.photos} />
      </section>
    ))}
  </Container>
  <CtaBand />
</BaseLayout>

<style>
  .jump {
    padding-block: var(--space-l);
    border-block-end: 1px solid var(--color-line);
  }

  .jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    justify-content: center;
  }

  .jump a {
    display: inline-flex;
    gap: var(--space-xs);
    align-items: center;
    min-block-size: var(--target-size);
    padding-inline: var(--space-m) var(--space-xs);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .jump a:hover {
    border-color: var(--color-navy);
    color: var(--color-navy);
  }

  .count {
    display: grid;
    place-items: center;
    min-inline-size: 1.75rem;
    block-size: 1.75rem;
    border-radius: var(--radius-pill);
    background: var(--color-subtle);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .group {
    display: grid;
    gap: var(--space-l);
    padding-block: var(--space-section);
    border-block-end: 1px solid var(--color-line);
    scroll-margin-block-start: var(--space-m);
  }

  .group:last-child {
    border-block-end: 0;
  }

  .heading {
    display: grid;
    gap: var(--space-xs);
    max-inline-size: var(--measure);
  }

  h2 {
    color: var(--color-ink);
  }

  .heading p {
    color: var(--color-muted);
  }
</style>
