---
import CompanyDetails from "../components/CompanyDetails.astro";
import CtaBand from "../components/CtaBand.astro";
import PageHeader from "../components/PageHeader.astro";
import Principles from "../components/Principles.astro";
import Section from "../components/Section.astro";
import ServiceArea from "../components/ServiceArea.astro";
import {
  aboutPage,
  areaSection,
  qualifications,
  qualificationsSection,
  story,
} from "../content/about";
import { site } from "../content/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title={`${aboutPage.metaTitle} | ${site.brandLines[0]}`}
  description={aboutPage.lead}
  breadcrumb={aboutPage.title}
>
  <PageHeader title={aboutPage.title} lead={aboutPage.lead} />
  <Section id="kim-jestesmy" title={story.title} width="page">
    <div class="story">
      <div class="text">
        {story.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <p class="contact-note">{story.contactNote}</p>
      </div>
      <CompanyDetails fields={["name", "phones", "email", "address", "taxId"]} class="panel" />
    </div>
  </Section>
  {qualifications.length > 0 && (
    <Section id="uprawnienia" title={qualificationsSection.title}>
      <ul class="qualifications" role="list">
        {qualifications.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </Section>
  )}
  <Principles />
  <Section id="obszar" title={areaSection.title}>
    <ServiceArea />
  </Section>
  <CtaBand />
</BaseLayout>

<style>
  .story {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }

  .text {
    display: grid;
    gap: var(--space-m);
    max-inline-size: var(--measure);
  }

  .contact-note {
    padding-inline-start: var(--space-m);
    border-inline-start: 3px solid var(--color-supply);
    font-weight: 600;
  }

  .panel {
    padding: var(--space-l);
    border: 1px solid var(--color-line);
    border-block-start: 3px solid var(--color-return);
  }

  .qualifications {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    justify-content: center;
  }

  .qualifications li {
    padding: var(--space-xs) var(--space-m);
    border: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  @media (width >= 56rem) {
    .story {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }
  }
</style>
