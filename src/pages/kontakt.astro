---
import CallCard from "../components/CallCard.astro";
import CompanyDetails from "../components/CompanyDetails.astro";
import ContactForm from "../components/ContactForm.astro";
import Container from "../components/Container.astro";
import PageHeader from "../components/PageHeader.astro";
import ServiceArea from "../components/ServiceArea.astro";
import { contactPage } from "../content/contact";
import { site, telHref } from "../content/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { hasContactForm } from "../lib/env";

const lead = hasContactForm ? contactPage.lead : contactPage.leadPhoneOnly;
---

<BaseLayout
  title={`${contactPage.metaTitle} | ${site.brandLines[0]}`}
  description={lead}
  breadcrumb={contactPage.title}
  contactDock={false}
>
  <PageHeader title={contactPage.title} lead={lead} />
  <Container width="page" class="layout">
    {hasContactForm ? <ContactForm /> : <CallCard />}
    <div class="details">
      <section aria-labelledby="contact-details-title">
        <h2 id="contact-details-title">
          {hasContactForm ? contactPage.detailsTitle : contactPage.companyTitle}
        </h2>
        {hasContactForm && (
          <ul class="phones" role="list">
            {site.contacts.map((contact) => (
              <li>
                <span class="person">{contact.name}</span>
                <a class="phone" href={telHref(contact.phone)}>
                  <span class="visually-hidden">Zadzwoń do: {contact.name},</span>
                  {contact.phone}
                </a>
              </li>
            ))}
          </ul>
        )}
        <CompanyDetails fields={["email", "hours", "address", "name", "taxId"]} />
      </section>
      <section id="obszar" aria-labelledby="contact-area-title">
        <h2 id="contact-area-title">{contactPage.areaTitle}</h2>
        <ServiceArea layout="stacked" />
      </section>
    </div>
  </Container>
</BaseLayout>

<style>
  .layout {
    display: grid;
    gap: var(--space-2xl);
    align-items: start;
    padding-block: var(--space-section);
  }

  .details {
    display: grid;
    gap: var(--space-xl);
  }

  .details section {
    scroll-margin-block-start: var(--space-m);
    display: grid;
    gap: var(--space-m);
    padding-block-start: var(--space-m);
    border-block-start: 1px solid var(--color-line);
  }

  h2 {
    color: var(--color-blue);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .phones {
    display: grid;
    gap: var(--space-s);
  }

  .phones li {
    display: grid;
  }

  .person {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .phone {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-size);
    color: var(--color-navy);
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: 500;
    text-decoration: none;
  }

  .phone:hover {
    text-decoration: underline;
  }

  @media (width >= 56rem) {
    .layout {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    }

    .details {
      grid-row: 1;
      grid-column: 1;
    }
  }
</style>
