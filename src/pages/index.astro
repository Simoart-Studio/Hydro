---
import Button from "../components/Button.astro";
import CtaBand from "../components/CtaBand.astro";
import Gallery from "../components/Gallery.astro";
import Hero from "../components/Hero.astro";
import Introduction from "../components/Introduction.astro";
import Notice from "../components/Notice.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import Section from "../components/Section.astro";
import ServiceArea from "../components/ServiceArea.astro";
import ServicesOverview from "../components/ServicesOverview.astro";
import Testimonials from "../components/Testimonials.astro";
import { areaSection } from "../content/about";
import { galleryPreview } from "../content/gallery";
import { site } from "../content/site";
import { steps, stepsSection } from "../content/steps";
import { testimonials } from "../content/testimonials";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title={`Kotły i pompy ciepła z dotacją, Tczew i Trójmiasto | ${site.brandLines[0]}`}
  description={site.description}
>
  <Hero />
  <ServicesOverview />
  <Introduction />
  <Section
    id="realizacje"
    title={galleryPreview.title}
    intro={galleryPreview.intro}
    tone="subtle"
    width="page"
  >
    <Gallery photos={galleryPreview.photos} compact />
    <Button href="/realizacje" arrow class="more">
      {galleryPreview.moreLabel}
    </Button>
  </Section>
  <ProcessSteps steps={steps} action={stepsSection.moreLink} />
  <Notice />
  {testimonials.length > 0 && <Testimonials testimonials={testimonials} />}
  <Section id="obszar" title={areaSection.title} tone="subtle">
    <ServiceArea class="area" />
  </Section>
  <CtaBand />
</BaseLayout>

<style>
  .more {
    justify-self: center;
  }

  .area {
    justify-items: center;
    text-align: center;
  }

  .area :global(.places) {
    justify-content: center;
  }
</style>
