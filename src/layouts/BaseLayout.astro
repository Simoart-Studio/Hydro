---
import semiboldFont from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-600-normal.woff2?url";
import regularFont from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url";
import ContactDock from "../components/ContactDock.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import type { FaqItem } from "../content/faq";
import { site } from "../content/site";
import { isNoindex } from "../lib/env";
import { breadcrumbSchema, businessSchema, faqSchema, toJsonLd } from "../lib/structuredData";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Nazwa podstrony w ścieżce okruszków dla wyszukiwarek. Strona główna jej nie podaje. */
  breadcrumb?: string;
  /** Pytania z odpowiedziami do danych strukturalnych FAQPage. */
  faq?: FaqItem[];
  /** Panel szybkiego kontaktu przy dolnej krawędzi; strona Kontakt go nie potrzebuje. */
  contactDock?: boolean;
}

const { title, description, breadcrumb, faq, contactDock = true } = Astro.props;
const base = Astro.site ?? new URL(Astro.url.origin);
// The file build format reports /dotacje.html, while the site links and serves /dotacje.
const canonicalPath = Astro.url.pathname.replace(/(index)?\.html$/, "").replace(/(.)\/$/, "$1");
const canonicalUrl = new URL(canonicalPath, base);
const ogImageUrl = new URL("/og.jpg", base);
const structuredData = [
  businessSchema(base),
  ...(breadcrumb ? [breadcrumbSchema(base, breadcrumb, canonicalPath)] : []),
  ...(faq ? [faqSchema(faq)] : []),
];
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {isNoindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#163a5f" />
    <link rel="preload" href={semiboldFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={regularFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: rozdzielacz ogrzewania podłogowego`} />
    <meta name="twitter:card" content="summary_large_image" />
    {structuredData.map((schema) => (
      <script type="application/ld+json" set:html={toJsonLd(schema)} />
    ))}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Przejdź do treści
    </a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    {contactDock && <ContactDock />}
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    inset-inline-start: var(--space-m);
    top: var(--space-m);
    z-index: 20;
    padding: var(--space-s) var(--space-m);
    border-radius: var(--radius);
    background: var(--color-ink);
    color: var(--color-bg);
    font-weight: 600;
    translate: 0 -200%;
  }

  .skip-link:focus-visible {
    translate: 0 0;
  }

  main:focus {
    outline: none;
  }
</style>
