---
import semiboldFont from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-600-normal.woff2?url";
import regularFont from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url";
import DemoNotice from "../components/DemoNotice.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { site } from "../content/site";
import { isDemo, isNoindex } from "../lib/env";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
// The file build format reports /dotacje.html, while the site links and serves /dotacje.
const canonicalPath = Astro.url.pathname.replace(/(index)?\.html$/, "").replace(/(.)\/$/, "$1");
const canonicalUrl = new URL(canonicalPath, Astro.site);
const ogImageUrl = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {isNoindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#1f4e5a" />
    <link rel="preload" href={semiboldFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={regularFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Przejdź do treści
    </a>
    {isDemo && <DemoNotice />}
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    inset-inline-start: var(--space-m);
    top: var(--space-m);
    z-index: 20;
    padding: var(--space-s) var(--space-m);
    border-radius: var(--radius);
    background: var(--color-ink);
    color: var(--color-bg);
    font-weight: 600;
    translate: 0 -200%;
  }

  .skip-link:focus-visible {
    translate: 0 0;
  }

  main:focus {
    outline: none;
  }
</style>
