---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  label: string;
  image?: ImageMetadata;
  alt?: string;
  href?: string;
  caption?: string;
}

const { label, image, alt = "", href, caption } = Astro.props;
const Wrapper = href ? "a" : "div";
---

<figure class="tile">
  <Wrapper class="frame" href={href}>
    {image ? (
      <Image
        class="image"
        src={image}
        alt={alt}
        widths={[320, 480, 720]}
        sizes="(min-width: 60rem) 18rem, (min-width: 36rem) 45vw, 90vw"
      />
    ) : (
      <span class="placeholder">Brak zdjęcia</span>
    )}
    <span class="label">{label}</span>
  </Wrapper>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .tile {
    display: grid;
    gap: var(--space-xs);
    min-inline-size: 0;
  }

  .frame {
    display: grid;
    justify-items: center;
    text-decoration: none;
  }

  .image,
  .placeholder {
    grid-area: 1 / 1;
    inline-size: 100%;
    aspect-ratio: 1;
    border-radius: var(--radius-sm) var(--radius-tile);
  }

  .image {
    block-size: auto;
    object-fit: cover;
    transition: filter 200ms ease;
  }

  .placeholder {
    display: grid;
    place-items: center;
    border: 2px dashed var(--color-field);
    color: var(--color-muted);
  }

  .label {
    z-index: 1;
    margin-block-start: -1.375rem;
    padding: var(--space-xs) var(--space-l);
    border-radius: var(--radius-pill);
    background: var(--color-navy);
    color: var(--color-on-navy);
    font-size: var(--text-sm);
    font-weight: 600;
    text-align: center;
  }

  a.frame:hover .image {
    filter: brightness(1.04) saturate(1.1);
  }

  a.frame:hover .label {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  figcaption {
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-align: center;
  }
</style>
