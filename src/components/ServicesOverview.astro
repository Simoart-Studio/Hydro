---
import { Image } from "astro:assets";
import { brands, brandsSection } from "../content/brands";
import type { ServiceIcon } from "../content/services";
import { services, servicesSection } from "../content/services";
import Button from "./Button.astro";
import Container from "./Container.astro";

// Line icons on a 40 × 40 grid, drawn with the same stroke as the process step icons.
const iconPaths: Record<ServiceIcon, string> = {
  paperwork:
    "M10 5h14l7 7v15M24 5v7h7M10 5v30h12M15 17h11M15 23h8M30 26a6 6 0 1 1 0 12 6 6 0 0 1 0-12zM27.5 32l2 2 3.5-4",
  discount:
    "M21 5h12a2 2 0 0 1 2 2v12L19 35a2 2 0 0 1-2.8 0L5 23.8a2 2 0 0 1 0-2.8zM28 12.5a.5.5 0 1 1 0 .01M14 26l8-8M15 19.5a1.5 1.5 0 1 1 0 .01M21 24.5a1.5 1.5 0 1 1 0 .01",
  tank: "M12 9a8 4 0 0 1 16 0v22a8 4 0 0 1-16 0zM12 9a8 4 0 0 0 16 0M12 17h16M12 24h16M28 13h6M28 28h6M6 13h6M6 28h6",
  installation: "M27 8a7 7 0 0 0-8 9L8 28a3 3 0 0 0 4 4l11-11a7 7 0 0 0 9-8l-4 4-4-1-1-4z",
};
---

<section id="oferta" class="services" aria-labelledby="oferta-title">
  <Container class="inner">
    <h2 id="oferta-title" class="visually-hidden">
      {servicesSection.title}
    </h2>
    <ul class="list" role="list">
      {services.map((service, index) => (
        <li class="item" style={`--i: ${index}`}>
          <span class="badge" aria-hidden="true">
            <svg viewBox="0 0 40 40" width="32" height="32">
              <path d={iconPaths[service.icon]} />
            </svg>
          </span>
          <div class="body">
            <h3>{service.title}</h3>
            <p class="summary">{service.summary}</p>
          </div>
          <Button href={service.href} variant="outline" size="small" arrow class="more">
            {servicesSection.moreLabel}
            <span class="visually-hidden">: {service.title}</span>
          </Button>
        </li>
      ))}
    </ul>
    {brands.length > 0 && (
      <div class="brands">
        <h3 class="visually-hidden">{brandsSection.title}</h3>
        <ul class="logos" role="list">
          {brands.map((brand) => (
            <li>
              <Image src={brand.logo} alt={brand.name} height={40} class="logo" />
            </li>
          ))}
        </ul>
      </div>
    )}
  </Container>
</section>

<style>
  .services {
    display: flow-root;
    padding-block-end: var(--space-2xl);
    background: var(--color-band);
    scroll-margin-block-start: calc(var(--hero-overlap) + var(--space-l));
  }

  .inner {
    display: grid;
    gap: var(--space-xl);
  }

  .list {
    position: relative;
    display: grid;
    gap: var(--space-m);
    margin-block-start: calc(-1 * var(--hero-overlap));
  }

  .item {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-s) var(--space-m);
    align-items: start;
    min-inline-size: 0;
    padding: var(--space-l);
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    animation: rise 640ms cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
    animation-delay: calc(120ms + var(--i) * 90ms);
    transition:
      translate 220ms ease,
      box-shadow 220ms ease;
  }

  /* A rule along the bottom edge fills in on hover, echoing the red underline under section titles. */
  .item::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: 3px;
    background: var(--color-accent);
    scale: 0 1;
    transform-origin: left;
    transition: scale 280ms ease;
  }

  .item:hover,
  .item:focus-within {
    translate: 0 -4px;
    box-shadow: 0 14px 30px color-mix(in srgb, var(--color-ink) 14%, transparent);
  }

  .item:hover::after,
  .item:focus-within::after {
    scale: 1 1;
  }

  .badge {
    display: grid;
    place-items: center;
    inline-size: 3.5rem;
    block-size: 3.5rem;
    border-radius: 50%;
    background: var(--color-hero-bg);
    color: var(--color-navy);
    box-shadow: inset 0 0 0 1px var(--color-line);
    transition:
      background-color 220ms ease,
      color 220ms ease;
  }

  .badge svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
    overflow: visible;
  }

  .item:hover .badge,
  .item:focus-within .badge {
    background: var(--color-navy);
    color: var(--color-on-navy);
  }

  .body {
    display: grid;
    gap: var(--space-2xs);
  }

  h3 {
    color: var(--color-ink);
    font-size: var(--text-lg);
  }

  .summary {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .more {
    grid-column: 2;
    justify-self: start;
  }

  .logos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m) var(--space-xl);
    align-items: center;
    justify-content: space-around;
  }

  .logo {
    inline-size: auto;
    block-size: 2.5rem;
    filter: grayscale(1);
    mix-blend-mode: multiply;
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 1.25rem;
    }
  }

  @media (width >= 36rem) {
    .list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .item {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto 1fr auto;
      justify-items: center;
      padding: var(--space-xl) var(--space-l) var(--space-l);
      text-align: center;
    }

    .body {
      gap: var(--space-xs);
    }

    .more {
      grid-column: auto;
      justify-self: center;
    }

    .badge {
      inline-size: 4rem;
      block-size: 4rem;
      margin-block-end: var(--space-2xs);
    }
  }

  @media (width >= 60rem) {
    .list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-l);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .item {
      animation: none;
    }
  }
</style>
