---
import { Image } from "astro:assets";
import { brands, brandsSection } from "../content/brands";
import type { ServiceIcon } from "../content/services";
import { services, servicesSection } from "../content/services";
import Button from "./Button.astro";
import Container from "./Container.astro";

// Line icons on a 40 × 40 grid, drawn with the same stroke as the process step icons.
const iconPaths: Record<ServiceIcon, string> = {
  paperwork:
    "M10 5h14l7 7v15M24 5v7h7M10 5v30h12M15 17h11M15 23h8M30 26a6 6 0 1 1 0 12 6 6 0 0 1 0-12zM27.5 32l2 2 3.5-4",
  discount:
    "M21 5h12a2 2 0 0 1 2 2v12L19 35a2 2 0 0 1-2.8 0L5 23.8a2 2 0 0 1 0-2.8zM28 12.5a.5.5 0 1 1 0 .01M14 26l8-8M15 19.5a1.5 1.5 0 1 1 0 .01M21 24.5a1.5 1.5 0 1 1 0 .01",
  tank: "M12 9a8 4 0 0 1 16 0v22a8 4 0 0 1-16 0zM12 9a8 4 0 0 0 16 0M12 17h16M12 24h16M28 13h6M28 28h6M6 13h6M6 28h6",
  installation: "M27 8a7 7 0 0 0-8 9L8 28a3 3 0 0 0 4 4l11-11a7 7 0 0 0 9-8l-4 4-4-1-1-4z",
};
---

<section id="oferta" class="services" aria-labelledby="oferta-title">
  <Container class="inner">
    <h2 id="oferta-title" class="visually-hidden">
      {servicesSection.title}
    </h2>
    <ul class="list" role="list" data-reveal>
      {services.map((service, index) => (
        <li class="item" style={`--i: ${index}`}>
          <span class="badge" aria-hidden="true">
            <svg viewBox="0 0 40 40" width="26" height="26">
              <path d={iconPaths[service.icon]} />
            </svg>
          </span>
          <div class="body">
            <h3>{service.title}</h3>
            <p class="summary">{service.summary}</p>
          </div>
          <Button href={service.href} variant="outline" size="small" arrow class="more">
            {servicesSection.moreLabel}
            <span class="visually-hidden">: {service.title}</span>
          </Button>
        </li>
      ))}
    </ul>
    {brands.length > 0 && (
      <div class="brands">
        <h3 class="visually-hidden">{brandsSection.title}</h3>
        <ul class="logos" role="list">
          {brands.map((brand) => (
            <li>
              <Image src={brand.logo} alt={brand.name} height={40} class="logo" />
            </li>
          ))}
        </ul>
      </div>
    )}
  </Container>
</section>

<script>
  // Cards stay hidden until the visitor has scrolled at least 100 px and the row is on screen, then fly in
  // from behind the left edge one after another. Without the observer they stay visible.
  const scrollTrigger = 100;
  const lists = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]"));
  const onScreen = new Set<Element>();

  const reveal = (list: Element) => list.setAttribute("data-revealed", "");

  if ("IntersectionObserver" in window && lists.length > 0) {
    const tryReveal = () => {
      if (window.scrollY < scrollTrigger) return;
      for (const list of onScreen) {
        reveal(list);
        observer.unobserve(list);
        onScreen.delete(list);
      }
      if (lists.every((list) => list.hasAttribute("data-revealed"))) {
        window.removeEventListener("scroll", tryReveal);
      }
    };

    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) onScreen.add(entry.target);
        else onScreen.delete(entry.target);
      }
      tryReveal();
    });

    lists.forEach((list) => observer.observe(list));
    window.addEventListener("scroll", tryReveal, { passive: true });
  } else {
    lists.forEach(reveal);
  }
</script>

<style>
  .services {
    display: flow-root;
    padding-block-end: var(--space-xl);
    background: var(--color-band);
    scroll-margin-block-start: calc(var(--hero-overlap) + var(--space-l));
  }

  .inner {
    display: grid;
    gap: var(--space-xl);
  }

  .list {
    position: relative;
    display: grid;
    gap: var(--space-s);
    inline-size: 100%;
    max-inline-size: 60rem;
    margin-block-start: calc(-1 * var(--hero-overlap));
    margin-inline: auto;
  }

  .item {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-2xs) var(--space-s);
    align-items: start;
    min-inline-size: 0;
    padding: var(--space-m);
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    transition:
      translate 220ms ease,
      box-shadow 220ms ease;
  }

  /* Hidden only when scripts run (the html.js class is set in the head), so the cards never vanish without JS. */
  :global(.js) [data-reveal]:not([data-revealed]) .item {
    opacity: 0;
  }

  [data-revealed] .item {
    animation: fly-in 1100ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
    animation-delay: calc(var(--i) * 260ms);
  }

  /* A rule along the bottom edge fills in on hover, echoing the red underline under section titles. */
  .item::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: 3px;
    background: var(--color-accent);
    scale: 0 1;
    transform-origin: left;
    transition: scale 280ms ease;
  }

  .item:hover,
  .item:focus-within {
    translate: 0 -3px;
    box-shadow: 0 12px 26px color-mix(in srgb, var(--color-ink) 14%, transparent);
  }

  .item:hover::after,
  .item:focus-within::after {
    scale: 1 1;
  }

  .badge {
    display: grid;
    grid-row: span 3;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: 50%;
    background: var(--color-hero-bg);
    color: var(--color-navy);
    box-shadow: inset 0 0 0 1px var(--color-line);
    transition:
      background-color 220ms ease,
      color 220ms ease;
  }

  .badge svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.2;
    overflow: visible;
  }

  .item:hover .badge,
  .item:focus-within .badge {
    background: var(--color-navy);
    color: var(--color-on-navy);
  }

  .body {
    display: grid;
    gap: var(--space-2xs);
  }

  h3 {
    color: var(--color-ink);
    font-size: var(--text-base);
  }

  .summary {
    color: var(--color-muted);
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .more {
    justify-self: start;
    margin-block-start: var(--space-xs);
  }

  .logos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m) var(--space-xl);
    align-items: center;
    justify-content: space-around;
  }

  .logo {
    inline-size: auto;
    block-size: 2.5rem;
    filter: grayscale(1);
    mix-blend-mode: multiply;
  }

  /* Each card starts beyond the left edge of the viewport and glides to its place, slowing down at the end. */
  @keyframes fly-in {
    from {
      opacity: 0;
      translate: -100vw 0;
    }

    40% {
      opacity: 1;
    }
  }

  @media (width >= 36rem) {
    .list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .item {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto 1fr auto;
      justify-items: center;
      padding: var(--space-l) var(--space-m) var(--space-m);
      text-align: center;
    }

    .badge {
      grid-row: auto;
      margin-block-end: var(--space-xs);
    }

    .more {
      justify-self: center;
    }
  }

  @media (width >= 60rem) {
    .list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-m);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-revealed] .item {
      animation: none;
    }
  }
</style>
