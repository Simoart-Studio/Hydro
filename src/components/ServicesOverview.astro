---
import { Image } from "astro:assets";
import { brands, brandsSection } from "../content/brands";
import type { ServiceIcon } from "../content/services";
import { services, servicesSection } from "../content/services";
import Button from "./Button.astro";
import Container from "./Container.astro";

// Line icons on a 40 × 40 grid, drawn with the same stroke as the process step icons.
const iconPaths: Record<ServiceIcon, string> = {
  paperwork:
    "M10 5h14l7 7v15M24 5v7h7M10 5v30h12M15 17h11M15 23h8M30 26a6 6 0 1 1 0 12 6 6 0 0 1 0-12zM27.5 32l2 2 3.5-4",
  discount:
    "M21 5h12a2 2 0 0 1 2 2v12L19 35a2 2 0 0 1-2.8 0L5 23.8a2 2 0 0 1 0-2.8zM28 12.5a.5.5 0 1 1 0 .01M14 26l8-8M15 19.5a1.5 1.5 0 1 1 0 .01M21 24.5a1.5 1.5 0 1 1 0 .01",
  tank: "M12 9a8 4 0 0 1 16 0v22a8 4 0 0 1-16 0zM12 9a8 4 0 0 0 16 0M12 17h16M12 24h16M28 13h6M28 28h6M6 13h6M6 28h6",
  installation: "M27 8a7 7 0 0 0-8 9L8 28a3 3 0 0 0 4 4l11-11a7 7 0 0 0 9-8l-4 4-4-1-1-4z",
};
---

<section id="oferta" class="services" aria-labelledby="oferta-title">
  <Container class="inner">
    <h2 id="oferta-title" class="visually-hidden">
      {servicesSection.title}
    </h2>
    <ul class="list" role="list" data-reveal>
      {services.map((service, index) => (
        <li class="item" style={`--i: ${index}`}>
          <span class="badge" aria-hidden="true">
            <svg viewBox="0 0 40 40" width="26" height="26">
              <path d={iconPaths[service.icon]} />
            </svg>
          </span>
          <div class="body">
            <h3>{service.title}</h3>
            <p class="summary">{service.summary}</p>
          </div>
          <Button href={service.href} variant="outline" size="small" arrow class="more">
            {servicesSection.moreLabel}
            <span class="visually-hidden">: {service.title}</span>
          </Button>
        </li>
      ))}
    </ul>
    {brands.length > 0 && (
      <div class="brands">
        <h3 class="visually-hidden">{brandsSection.title}</h3>
        <ul class="logos" role="list">
          {brands.map((brand) => (
            <li>
              <Image src={brand.logo} alt={brand.name} height={40} class="logo" />
            </li>
          ))}
        </ul>
      </div>
    )}
  </Container>
</section>

<script>
  // After the visitor has scrolled 70 px, the first card glides in from behind the left edge and the others
  // then fan out from under it to their places. When the whole row fits on screen, scrolling is held until
  // the last card lands, then released.
  // When it does not (stacked cards on a phone), each card enters as it scrolls into view, without a hold.
  const scrollTrigger = 70;
  const list = document.querySelector<HTMLElement>("[data-reveal]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const scrollKeys = new Set(["ArrowUp", "ArrowDown", "PageUp", "PageDown", "Home", "End", " "]);

  const lockScroll = () => {
    const lockedY = window.scrollY;
    const block = (event: Event) => event.preventDefault();
    const blockKeys = (event: KeyboardEvent) => {
      const target = event.target as HTMLElement | null;
      if (target?.closest("input, textarea, select, [contenteditable]")) return;
      if (scrollKeys.has(event.key)) event.preventDefault();
    };
    const hold = () => {
      if (window.scrollY !== lockedY) window.scrollTo({ top: lockedY, behavior: "instant" });
    };

    document.documentElement.setAttribute("data-scroll-locked", "");
    window.addEventListener("wheel", block, { passive: false });
    window.addEventListener("touchmove", block, { passive: false });
    window.addEventListener("keydown", blockKeys);
    window.addEventListener("scroll", hold);

    return () => {
      document.documentElement.removeAttribute("data-scroll-locked");
      window.removeEventListener("wheel", block);
      window.removeEventListener("touchmove", block);
      window.removeEventListener("keydown", blockKeys);
      window.removeEventListener("scroll", hold);
    };
  };

  // Each card travels just far enough to start fully behind the left edge, which keeps the speed even.
  const measureStart = (item: HTMLElement) => {
    const { right } = item.getBoundingClientRect();
    item.style.setProperty("--from", `${-Math.ceil(right + 24)}px`);
  };

  const fitsOnScreen = (items: HTMLElement[]) =>
    items.every((item) => {
      const { top, bottom } = item.getBoundingClientRect();
      return top >= 0 && bottom <= window.innerHeight;
    });

  const playRow = (target: HTMLElement, items: HTMLElement[]) => {
    const [first, ...rest] = items;
    if (first) {
      measureStart(first);
      // The other cards start stacked exactly under the first one and travel right to their own slots.
      const firstLeft = first.getBoundingClientRect().left;
      for (const item of rest) {
        item.style.setProperty(
          "--from",
          `${Math.round(firstLeft - item.getBoundingClientRect().left)}px`,
        );
      }
    }
    const unlock = lockScroll();
    let released = false;
    const release = () => {
      if (released) return;
      released = true;
      unlock();
    };

    target.setAttribute("data-revealed", "");

    const last = items.at(-1);
    if (!last) return release();
    last.addEventListener("animationend", release, { once: true });
    // Safety net: release even if the animation event never fires (for example in a background tab).
    const style = getComputedStyle(last);
    const seconds = parseFloat(style.animationDelay) + parseFloat(style.animationDuration);
    window.setTimeout(release, seconds * 1000 + 300);
  };

  const playOneByOne = (target: HTMLElement, items: HTMLElement[]) => {
    target.setAttribute("data-stacked", "");
    const observer = new IntersectionObserver(
      (entries) => {
        const entering = entries.filter((entry) => entry.isIntersecting);
        entering.forEach((entry, order) => {
          const item = entry.target as HTMLElement;
          measureStart(item);
          item.style.setProperty("--order", String(order));
          item.setAttribute("data-shown", "");
          observer.unobserve(item);
        });
      },
      { rootMargin: "0px 0px -10% 0px" },
    );
    items.forEach((item) => observer.observe(item));
  };

  if (list) {
    const items = Array.from(list.querySelectorAll<HTMLElement>(".item"));

    if (reducedMotion || !("IntersectionObserver" in window)) {
      list.setAttribute("data-revealed", "");
    } else {
      let onScreen = false;
      let started = false;

      const start = () => {
        if (started || !onScreen || window.scrollY < scrollTrigger) return;
        started = true;
        observer.disconnect();
        window.removeEventListener("scroll", start);
        if (fitsOnScreen(items)) playRow(list, items);
        else playOneByOne(list, items);
      };

      const observer = new IntersectionObserver((entries) => {
        onScreen = entries.some((entry) => entry.isIntersecting);
        start();
      });

      observer.observe(list);
      window.addEventListener("scroll", start, { passive: true });
    }
  }
</script>

<style>
  .services {
    display: flow-root;
    padding-block-end: var(--space-xl);
    background: var(--color-band);
    scroll-margin-block-start: calc(var(--hero-overlap) + var(--space-l));
  }

  .inner {
    display: grid;
    gap: var(--space-xl);
  }

  .list {
    position: relative;
    display: grid;
    gap: var(--space-l);
    inline-size: 100%;
    max-inline-size: 66rem;
    margin-block-start: calc(-1 * var(--hero-overlap));
    margin-inline: auto;
  }

  .item {
    /* Later cards sit lower, so each one slides in from under the card already in place. */
    position: relative;
    z-index: calc(4 - var(--i));
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-2xs) var(--space-s);
    align-items: start;
    min-inline-size: 0;
    padding: var(--space-m);
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    transition:
      translate 220ms ease,
      box-shadow 220ms ease;
  }

  /* Hidden only when scripts run (the html.js class is set in the head), so the cards never vanish without JS. */
  :global(.js) [data-reveal]:not([data-revealed]) .item:not([data-shown]) {
    opacity: 0;
  }

  [data-stacked] .item[data-shown] {
    animation: fly-in 900ms cubic-bezier(0.22, 1, 0.36, 1) backwards;
    animation-delay: calc(var(--order, 0) * 180ms);
  }

  /* Row on wide screens: the first card arrives in 0.8 s, then the rest fan out from under it in 0.8 s. */
  [data-revealed] .item {
    will-change: transform, opacity;
  }

  [data-revealed] .item:first-child {
    animation: fly-in 800ms cubic-bezier(0.22, 1, 0.36, 1) backwards;
  }

  [data-revealed] .item:not(:first-child) {
    animation: fan-out 1600ms linear backwards;
  }

  /* A rule along the bottom edge fills in on hover, echoing the red underline under section titles. */
  .item::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: 3px;
    background: var(--color-accent);
    scale: 0 1;
    transform-origin: left;
    transition: scale 280ms ease;
  }

  .item:hover,
  .item:focus-within {
    translate: 0 -3px;
    box-shadow: 0 12px 26px color-mix(in srgb, var(--color-ink) 14%, transparent);
  }

  .item:hover::after,
  .item:focus-within::after {
    scale: 1 1;
  }

  .badge {
    display: grid;
    grid-row: span 3;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: 50%;
    background: var(--color-hero-bg);
    color: var(--color-navy);
    box-shadow: inset 0 0 0 1px var(--color-line);
    transition:
      background-color 220ms ease,
      color 220ms ease;
  }

  .badge svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.2;
    overflow: visible;
  }

  .item:hover .badge,
  .item:focus-within .badge {
    background: var(--color-navy);
    color: var(--color-on-navy);
  }

  .body {
    display: grid;
    gap: var(--space-2xs);
  }

  h3 {
    color: var(--color-ink);
    font-size: var(--text-base);
  }

  .summary {
    color: var(--color-muted);
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .more {
    justify-self: start;
    margin-block-start: var(--space-xs);
  }

  .logos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m) var(--space-xl);
    align-items: center;
    justify-content: space-around;
  }

  .logo {
    inline-size: auto;
    block-size: 2.5rem;
    filter: grayscale(1);
    mix-blend-mode: multiply;
  }

  /* Each card starts just behind the left edge (--from is measured per card), glides in and settles with a
     slight scale-up, so the motion stays even and lands softly. */
  @keyframes fly-in {
    0% {
      opacity: 0;
      transform: translate3d(var(--from, -100vw), 0, 0) scale(0.96);
    }

    35% {
      opacity: 1;
    }

    100% {
      opacity: 1;
      transform: none;
    }
  }

  /* Hidden for the first half while the first card arrives, then slides out from under it. */
  @keyframes fan-out {
    0%,
    50% {
      opacity: 0;
      transform: translate3d(var(--from, 0), 0, 0);
    }

    50.01% {
      opacity: 1;
      transform: translate3d(var(--from, 0), 0, 0);
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }

    100% {
      opacity: 1;
      transform: none;
    }
  }

  @media (width >= 36rem) {
    .list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .item {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto 1fr auto;
      justify-items: center;
      padding: var(--space-l) var(--space-m) var(--space-m);
      text-align: center;
    }

    .badge {
      grid-row: auto;
      margin-block-end: var(--space-xs);
    }

    .more {
      justify-self: center;
    }
  }

  @media (width >= 60rem) {
    .list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-xl);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-revealed] .item {
      animation: none;
    }
  }
</style>
