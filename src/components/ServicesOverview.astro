---
import { Image } from "astro:assets";
import { brands, brandsSection } from "../content/brands";
import { services, servicesSection } from "../content/services";
import Button from "./Button.astro";
import Container from "./Container.astro";
---

<section id="oferta" class="services" aria-labelledby="oferta-title">
  <Container width="column" class="inner">
    <div class="card">
      <h2 id="oferta-title" class="visually-hidden">
        {servicesSection.title}
      </h2>
      <ul class="list" role="list">
        {services.map((service) => (
          <li class="item">
            <h3>{service.title}</h3>
            <p class="summary">{service.summary}</p>
            <Button href={service.href} variant="outline" size="small" arrow class="more">
              {servicesSection.moreLabel}
              <span class="visually-hidden">: {service.title}</span>
            </Button>
          </li>
        ))}
      </ul>
    </div>
    {brands.length > 0 && (
      <div class="brands">
        <h3 class="visually-hidden">{brandsSection.title}</h3>
        <ul class="logos" role="list">
          {brands.map((brand) => (
            <li>
              <Image src={brand.logo} alt={brand.name} height={40} class="logo" />
            </li>
          ))}
        </ul>
      </div>
    )}
  </Container>
</section>

<style>
  .services {
    display: flow-root;
    padding-block-end: var(--space-xl);
    background: var(--color-band);
    scroll-margin-block-start: calc(var(--hero-overlap) + var(--space-l));
  }

  .inner {
    display: grid;
    gap: var(--space-xl);
  }

  .card {
    position: relative;
    margin-block-start: calc(-1 * var(--hero-overlap));
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .list {
    display: grid;
    gap: 1px;
    background: var(--color-line);
  }

  .item {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    align-items: center;
    min-inline-size: 0;
    padding: var(--space-l) var(--space-s);
    background: var(--color-surface);
    text-align: center;
  }

  h3 {
    color: var(--color-ink);
    font-size: var(--text-lg);
  }

  .summary {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .more {
    margin-block-start: auto;
  }

  .logos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m) var(--space-xl);
    align-items: center;
    justify-content: space-around;
  }

  .logo {
    inline-size: auto;
    block-size: 2.5rem;
    filter: grayscale(1);
    mix-blend-mode: multiply;
  }

  @media (width >= 36rem) {
    .list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 60rem) {
    .list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
