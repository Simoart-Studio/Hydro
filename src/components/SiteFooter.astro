---
import { mainNavigation, privacyPolicyLink } from "../content/navigation";
import { site, siteCredit } from "../content/site";
import CompanyDetails from "./CompanyDetails.astro";
import Container from "./Container.astro";
import { Image } from "astro:assets";
import logo from "../assets/brand/logo.jpeg";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <Container class="columns">
    <div class="about">
      <Image class="logo" src={logo} alt={site.name} width={144} densities={[1, 2]} />
      <p>{site.description}</p>
    </div>
    <section aria-labelledby="footer-company">
      <h2 id="footer-company">Dane firmy</h2>
      <CompanyDetails fields={["name", "phones", "email", "address", "taxId", "hours"]} />
    </section>
    <section aria-labelledby="footer-area">
      <h2 id="footer-area">Obszar działania</h2>
      <p>{site.serviceArea.summary}</p>
      <a class="area-link" href="/kontakt#obszar">
        Lista miejscowości
      </a>
    </section>
    <nav aria-labelledby="footer-shortcuts">
      <h2 id="footer-shortcuts">Strony</h2>
      <ul class="links" role="list">
        {mainNavigation.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </Container>
  <Container class="legal">
    <p class="disclaimer">
      Informacje na tej stronie mają charakter ogólny. Przyznanie i wysokość dotacji zależą od
      programu oraz indywidualnej kwalifikacji, a firma nie gwarantuje uzyskania dofinansowania.
    </p>
    <p class="meta">
      <span>
        © {year} {site.legalName}
      </span>
      <a href={privacyPolicyLink.href}>{privacyPolicyLink.label}</a>
      <span class="credit">
        {siteCredit.label}{" "}
        {siteCredit.url ? (
          <a href={siteCredit.url} rel="nofollow noopener" target="_blank">
            {siteCredit.name}
            <span class="visually-hidden"> (otwiera się w nowej karcie)</span>
          </a>
        ) : (
          siteCredit.name
        )}
      </span>
    </p>
  </Container>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-2xl) var(--space-xl);
    background: var(--color-subtle);
    font-size: var(--text-sm);
  }

  .columns {
    display: grid;
    gap: var(--space-xl);
  }

  .columns > * {
    display: grid;
    gap: var(--space-s);
    align-content: start;
    min-inline-size: 0;
  }

  .logo {
    border-radius: var(--radius);
  }

  .about p:last-child {
    max-inline-size: 36ch;
    color: var(--color-muted);
  }

  h2 {
    color: var(--color-petrol);
    font-size: var(--text-base);
  }

  .area-link {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    min-block-size: var(--target-size);
  }

  .links a {
    display: flex;
    align-items: center;
    min-block-size: var(--target-size);
  }

  .legal {
    display: grid;
    gap: var(--space-m);
    margin-block-start: var(--space-2xl);
    padding-block-start: var(--space-l);
    border-block-start: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .disclaimer {
    max-inline-size: var(--measure);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-l);
    align-items: center;
  }

  .meta a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-size);
    color: var(--color-ink);
  }

  @media (width >= 40rem) {
    .credit {
      margin-inline-start: auto;
    }

    .columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 64rem) {
    .columns {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1.2fr) minmax(0, 1fr) minmax(0, 0.8fr);
    }
  }
</style>
