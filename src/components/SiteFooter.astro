---
import { googleTagId } from "../lib/env";
import { mainNavigation, privacyPolicyLink } from "../content/navigation";
import { site } from "../content/site";
import CompanyDetails from "./CompanyDetails.astro";
import Container from "./Container.astro";
import { Image } from "astro:assets";
import logo from "../assets/brand/logo.jpeg";

const year = new Date().getFullYear();
---

<footer class="site-footer on-navy">
  <Container class="columns">
    <div class="about">
      <Image class="logo" src={logo} alt={site.name} width={144} densities={[1, 2]} />
      <p>{site.description}</p>
    </div>
    <section aria-labelledby="footer-company">
      <h2 id="footer-company">Dane firmy</h2>
      <CompanyDetails fields={["name", "phones", "email", "address", "taxId", "hours"]} />
    </section>
    <section aria-labelledby="footer-area">
      <h2 id="footer-area">Obszar działania</h2>
      <p>{site.serviceArea.summary}</p>
      <a class="area-link" href="/kontakt#obszar">
        Lista miejscowości
      </a>
    </section>
    <nav aria-labelledby="footer-shortcuts">
      <h2 id="footer-shortcuts">Strony</h2>
      <ul class="links" role="list">
        {mainNavigation.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </Container>
  <Container class="legal">
    <p class="disclaimer">
      Informacje na tej stronie mają charakter ogólny. Przyznanie i wysokość dotacji zależą od
      programu oraz indywidualnej kwalifikacji, a firma nie gwarantuje uzyskania dofinansowania.
    </p>
    <p class="meta">
      <span>
        © {year} {site.name}
      </span>
      <a href={privacyPolicyLink.href}>{privacyPolicyLink.label}</a>
      {googleTagId && (
        <button type="button" class="consent-open" data-consent-open>
          Ustawienia cookies
        </button>
      )}
    </p>
  </Container>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-2xl) var(--space-xl);
    background: var(--surface-navy-deep);
    font-size: var(--text-sm);
  }

  .columns {
    display: grid;
    gap: var(--space-xl);
  }

  .columns > * {
    display: grid;
    gap: var(--space-s);
    align-content: start;
    min-inline-size: 0;
  }

  .logo {
    border-radius: var(--radius);
    box-shadow: 0 0 0 1px var(--color-line);
  }

  .about p:last-child {
    max-inline-size: 36ch;
    color: var(--color-muted);
  }

  h2 {
    color: var(--color-navy);
    font-size: var(--text-base);
  }

  .area-link {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    min-block-size: var(--target-size);
  }

  .links a:hover,
  .area-link:hover {
    color: var(--color-accent-text);
  }

  .links a {
    display: flex;
    align-items: center;
    min-block-size: var(--target-size);
  }

  .legal {
    display: grid;
    gap: var(--space-m);
    margin-block-start: var(--space-2xl);
    padding-block-start: var(--space-l);
    border-block-start: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .disclaimer {
    max-inline-size: var(--measure);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-l);
    align-items: center;
  }

  .meta a,
  .consent-open {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-size);
    color: var(--color-ink);
  }

  .consent-open {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .consent-open:hover {
    text-decoration-thickness: 2px;
  }

  @media (width >= 40rem) {
    .columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 64rem) {
    .columns {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1.2fr) minmax(0, 1fr) minmax(0, 0.8fr);
    }
  }
</style>
