---
import { site } from "../content/site";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["service-area", className]}>
  <p class="summary">{site.serviceArea.summary}</p>
  <ul class="places" role="list" aria-label="Miejscowości, w których pracujemy">
    {site.serviceArea.places.map((place) => (
      <li>{place}</li>
    ))}
  </ul>
  <p class="note">Nie widzisz swojej miejscowości? Zadzwoń, sprawdzimy dojazd.</p>
</div>

<style>
  .service-area {
    display: grid;
    gap: var(--space-m);
  }

  .summary {
    max-inline-size: var(--measure);
  }

  .places {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .places li {
    padding: var(--space-2xs) var(--space-s);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    font-size: var(--text-sm);
  }

  .note {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
</style>
