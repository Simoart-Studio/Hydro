---
import { site, telHref } from "../content/site";
import PhoneIcon from "./PhoneIcon.astro";
import ServiceAreaMap from "./ServiceAreaMap.astro";

interface Props {
  /** split: lista obok mapy na szerokim ekranie; stacked: lista pod mapą (kolumna o połowie szerokości). */
  layout?: "split" | "stacked";
  /** Telefony pod listą miejscowości. Na stronie kontaktu są już wyżej, więc tam je wyłączamy. */
  calls?: boolean;
  class?: string;
}

const { layout = "split", calls = true, class: className } = Astro.props;
const { places, reachKm } = site.serviceArea;
// Text colours come from the shared tokens, so the list reads on white and inside a navy section alike.
---

<div class:list={["service-area", layout, className]}>
  <ServiceAreaMap />
  <div class="info">
    <p class="eyebrow">Działamy lokalnie</p>
    <p class="summary">{site.serviceArea.summary}</p>
    <ul class="places" role="list" aria-label="Miejscowości, w których pracujemy">
      {places.map((place) => (
        <li data-place-link={place.name}>{place.name}</li>
      ))}
    </ul>
    <p class="reach">
      <strong>+ do {reachKm} km</strong> od powyższych miejscowości
    </p>
    <div class="check">
      <p class="note">Nie widzisz swojej miejscowości? Zadzwoń, sprawdzimy dojazd.</p>
      {calls && (
        <ul class="call-list" role="list">
          {site.contacts.map((contact) => (
            <li>
              <a href={telHref(contact.phone)}>
                <PhoneIcon />
                <span class="person">{contact.name}</span>
                <strong>{contact.phone}</strong>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</div>

<style>
  .service-area {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  .info {
    display: grid;
    gap: var(--space-m);
    align-content: start;
  }

  .eyebrow {
    display: inline-flex;
    gap: var(--space-xs);
    align-items: center;
    color: var(--color-accent-text);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    content: "";
    inline-size: 1.5rem;
    block-size: 2px;
    background: var(--color-accent);
  }

  .summary {
    max-inline-size: var(--measure);
    color: var(--color-ink);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .places {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .places li {
    cursor: default;
    transition: color 150ms ease;
  }

  .places li:not(:last-child)::after {
    content: "•";
    margin-inline: var(--space-xs);
    color: var(--color-accent);
  }

  .places li:hover {
    color: var(--color-ink);
  }

  .reach {
    justify-self: start;
    padding: var(--space-xs) var(--space-m);
    border: 1px solid color-mix(in srgb, var(--color-accent) 60%, transparent);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-ink);
    font-size: var(--text-sm);
  }

  .reach strong {
    color: var(--color-accent-text);
  }

  .check {
    display: grid;
    gap: var(--space-xs);
    padding-block-start: var(--space-m);
    border-block-start: 1px solid var(--color-line);
  }

  .note {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .call-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .call-list a {
    display: inline-flex;
    gap: var(--space-xs);
    align-items: center;
    min-block-size: var(--target-size);
    padding: var(--space-2xs) var(--space-m) var(--space-2xs) var(--space-s);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    color: var(--color-ink);
    font-size: var(--text-sm);
    text-decoration: none;
    transition:
      border-color 150ms ease,
      background-color 150ms ease;
  }

  .call-list a:hover {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
  }

  .person {
    color: var(--color-muted);
  }

  @media (width >= 56rem) {
    /* The list leads, the map sits to the side. */
    .split {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: var(--space-2xl);
    }

    .split .info {
      grid-row: 1;
    }
  }
</style>
