---
import { mainNavigation, primaryCta } from "../content/navigation";
import { phoneHref, primaryContact, site } from "../content/site";
import Button from "./Button.astro";
import Container from "./Container.astro";
import Logo from "./Logo.astro";
import PhoneIcon from "./PhoneIcon.astro";

const currentPath = Astro.url.pathname.replace(/(index)?\.html$/, "").replace(/\/$/, "") || "/";
const isCurrent = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="site-header" data-site-header>
  <Container class="bar">
    <a class="brand" href="/" data-home-link aria-label={`${site.name}, strona główna`}>
      <Logo />
      <span class="brand-name" aria-hidden="true">
        <span class="brand-primary">{site.brandLines[0]}</span>
        <span class="brand-secondary">{site.brandLines[1]}</span>
      </span>
    </a>
    <nav class="desktop-nav" aria-label="Menu główne">
      <ul class="desktop-list" role="list">
        {mainNavigation.map((link) => (
          <li>
            <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="actions">
      <Button variant="dark" href={phoneHref} class="phone">
        <PhoneIcon />
        <span class="visually-hidden">Zadzwoń:</span>
        {primaryContact.phone}
      </Button>
      <details class="menu" data-mobile-menu>
        <summary class="menu-toggle">
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <span class="visually-hidden">Menu</span>
        </summary>
        <div class="menu-panel">
          <nav aria-label="Menu">
            <ul class="menu-list" role="list">
              {mainNavigation.map((link) => (
                <li>
                  <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <Button href={primaryCta.href} arrow>
            {primaryCta.label}
          </Button>
        </div>
      </details>
    </div>
  </Container>
  <div class="strip"></div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const menu = document.querySelector<HTMLDetailsElement>("[data-mobile-menu]");

  // On the home page the logo glides back to the top instead of reloading the page.
  const homeLink = document.querySelector<HTMLAnchorElement>("[data-home-link]");
  const isHome = window.location.pathname === "/" || window.location.pathname === "/index.html";

  if (homeLink && isHome) {
    homeLink.addEventListener("click", (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0)
        return;
      event.preventDefault();
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
      if (window.location.hash) history.replaceState(null, "", "/");
    });
  }

  if (header) {
    // The shadow appears once the page moves under the header, so it reads as lifted only when it needs to.
    let ticking = false;
    const update = () => {
      header.toggleAttribute("data-scrolled", window.scrollY > 8);
      ticking = false;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }

  if (menu) {
    menu.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) {
        menu.open = false;
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--color-surface);
    transition: box-shadow 200ms ease;
  }

  .site-header[data-scrolled] {
    box-shadow: 0 6px 18px color-mix(in srgb, var(--color-ink) 10%, transparent);
  }

  .bar {
    display: flex;
    gap: var(--space-m);
    align-items: center;
    padding-block: var(--space-s);
    transition: padding-block 200ms ease;
  }

  [data-scrolled] .bar {
    padding-block: var(--space-xs);
  }

  .brand {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
    min-block-size: var(--target-size);
    text-decoration: none;
    white-space: nowrap;
  }

  .brand-name {
    display: grid;
    line-height: 1.15;
  }

  .brand-primary {
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .brand-secondary {
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .desktop-nav {
    display: none;
    flex: 1;
    min-inline-size: 0;
  }

  .desktop-list {
    display: flex;
    gap: var(--space-2xs);
    justify-content: center;
  }

  .desktop-list a {
    display: flex;
    align-items: center;
    min-block-size: var(--target-size);
    padding-inline: var(--space-s);
    border-block-end: 2px solid transparent;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .desktop-list a:hover {
    color: var(--color-accent);
  }

  .desktop-list a[aria-current="page"] {
    border-block-end-color: var(--color-accent);
    color: var(--color-accent);
  }

  .actions {
    display: flex;
    margin-inline-start: auto;
    gap: var(--space-xs);
    align-items: center;
  }

  .phone {
    padding-inline: var(--space-m);
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .menu-toggle {
    display: grid;
    place-items: center;
    inline-size: var(--target-size);
    block-size: var(--target-size);
    border-radius: 50%;
    list-style: none;
    cursor: pointer;
  }

  .menu-toggle::-webkit-details-marker {
    display: none;
  }

  .menu-toggle:hover,
  .menu[open] .menu-toggle {
    background: var(--color-subtle);
  }

  .menu-toggle svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 2;
  }

  .menu-panel {
    position: absolute;
    inset-inline-end: max(var(--gutter), calc((100% - var(--width-page)) / 2));
    top: 100%;
    display: grid;
    gap: var(--space-m);
    inline-size: min(20rem, 100% - 2 * var(--gutter));
    padding: var(--space-m) var(--space-l) var(--space-l);
    border-radius: 0 0 var(--radius) var(--radius);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .menu-list a {
    display: flex;
    align-items: center;
    min-block-size: var(--target-size);
    border-block-end: 1px solid var(--color-line);
    font-weight: 600;
    text-decoration: none;
  }

  .menu-list a:hover,
  .menu-list a[aria-current="page"] {
    color: var(--color-accent);
  }

  .strip {
    block-size: 0.375rem;
    background: var(--color-navy);
  }

  @media (width < 30rem) {
    .brand-name {
      display: none;
    }
  }

  @media (width >= 64rem) {
    .desktop-nav {
      display: block;
    }

    .menu {
      display: none;
    }
  }
</style>
