---
import { mainNavigation, primaryCta } from "../content/navigation";
import { phoneHref, site } from "../content/site";
import Button from "./Button.astro";
import Container from "./Container.astro";
import Logo from "./Logo.astro";
import PhoneIcon from "./PhoneIcon.astro";

const currentPath = Astro.url.pathname.replace(/(index)?\.html$/, "").replace(/\/$/, "") || "/";
const isCurrent = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="site-header">
  <Container class="bar">
    <a class="brand" href="/" aria-label={`${site.name}, strona główna`}>
      <Logo />
      <span class="brand-name">{site.name}</span>
    </a>
    <nav class="desktop-nav" aria-label="Menu główne">
      <ul class="desktop-list" role="list">
        {mainNavigation.map((link) => (
          <li>
            <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="actions">
      <Button variant="dark" href={phoneHref} class="phone">
        <PhoneIcon />
        <span class="visually-hidden">Zadzwoń:</span>
        {site.phone}
      </Button>
      <details class="menu" data-mobile-menu>
        <summary class="menu-toggle">
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <span class="visually-hidden">Menu</span>
        </summary>
        <div class="menu-panel">
          <nav aria-label="Menu">
            <ul class="menu-list" role="list">
              {mainNavigation.map((link) => (
                <li>
                  <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <Button href={primaryCta.href} arrow>
            {primaryCta.label}
          </Button>
        </div>
      </details>
    </div>
  </Container>
  <div class="strip"></div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>("[data-mobile-menu]");

  if (menu) {
    menu.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) {
        menu.open = false;
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    background: var(--color-surface);
  }

  .bar {
    display: flex;
    gap: var(--space-m);
    align-items: center;
    padding-block: var(--space-s);
  }

  .brand {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
    min-block-size: var(--target-size);
    font-size: var(--text-lg);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .desktop-nav {
    display: none;
    flex: 1;
    min-inline-size: 0;
  }

  .desktop-list {
    display: flex;
    gap: var(--space-2xs);
    justify-content: center;
  }

  .desktop-list a {
    display: flex;
    align-items: center;
    min-block-size: var(--target-size);
    padding-inline: var(--space-s);
    border-block-end: 2px solid transparent;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .desktop-list a:hover {
    color: var(--color-coral-strong);
  }

  .desktop-list a[aria-current="page"] {
    border-block-end-color: var(--color-coral-strong);
    color: var(--color-coral-strong);
  }

  .actions {
    display: flex;
    margin-inline-start: auto;
    gap: var(--space-xs);
    align-items: center;
  }

  .phone {
    padding-inline: var(--space-m);
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .menu-toggle {
    display: grid;
    place-items: center;
    inline-size: var(--target-size);
    block-size: var(--target-size);
    border-radius: 50%;
    list-style: none;
    cursor: pointer;
  }

  .menu-toggle::-webkit-details-marker {
    display: none;
  }

  .menu-toggle:hover,
  .menu[open] .menu-toggle {
    background: var(--color-subtle);
  }

  .menu-toggle svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 2;
  }

  .menu-panel {
    position: absolute;
    inset-inline-end: max(var(--gutter), calc((100% - var(--width-page)) / 2));
    top: 100%;
    display: grid;
    gap: var(--space-m);
    inline-size: min(20rem, 100% - 2 * var(--gutter));
    padding: var(--space-m) var(--space-l) var(--space-l);
    border-radius: 0 0 var(--radius) var(--radius);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .menu-list a {
    display: flex;
    align-items: center;
    min-block-size: var(--target-size);
    border-block-end: 1px solid var(--color-line);
    font-weight: 600;
    text-decoration: none;
  }

  .menu-list a:hover,
  .menu-list a[aria-current="page"] {
    color: var(--color-coral-strong);
  }

  .strip {
    block-size: clamp(0.75rem, 0.5rem + 1vw, 1.25rem);
    background: var(--color-petrol);
  }

  @media (width < 30rem) {
    .brand-name {
      display: none;
    }
  }

  @media (width >= 64rem) {
    .desktop-nav {
      display: block;
    }

    .menu {
      display: none;
    }
  }
</style>
