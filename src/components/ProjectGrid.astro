---
import type { Project } from "../content/projects";
import PhotoTile from "./PhotoTile.astro";
import TileGrid from "./TileGrid.astro";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<TileGrid>
  {projects.map((project) => (
    <li class="project">
      <PhotoTile
        label={`${project.city}, ${project.heatSource}`}
        image={project.photo?.src}
        alt={project.photo?.alt}
        caption={String(project.year)}
      />
      {project.summary && <p class="summary">{project.summary}</p>}
    </li>
  ))}
</TileGrid>

<style>
  .project {
    display: grid;
    gap: var(--space-xs);
    align-content: start;
  }

  .summary {
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-align: center;
  }
</style>
