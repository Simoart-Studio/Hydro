---
import { contactForm, heatSources, photoLimits } from "../content/contact";
import { privacyPolicyLink } from "../content/navigation";
import { emailHref, phoneHref, primaryContact, site, telHref } from "../content/site";
import { formEndpoint, isFormConnected } from "../lib/env";
import Button from "./Button.astro";
import PhoneIcon from "./PhoneIcon.astro";

const { fields, success } = contactForm;
---

<div class="contact-card">
  <form
    class="contact-form"
    method="post"
    enctype="multipart/form-data"
    action={isFormConnected ? formEndpoint : undefined}
    aria-labelledby="contact-form-title"
    data-contact-form
    data-connected={isFormConnected ? "" : undefined}
  >
    <header class="intro">
      <p class="eyebrow">{contactForm.eyebrow}</p>
      <h2 id="contact-form-title">{contactForm.title}</h2>
      <p class="note">{contactForm.requiredNote}</p>
      {!isFormConnected && (
        <p class="pending">
          {contactForm.notConnected.notice} <a href={phoneHref}>{primaryContact.phone}</a>
          {site.email && (
            <>
              {" "}
              {contactForm.notConnected.orEmail} <a href={emailHref}>{site.email}</a>
            </>
          )}
        </p>
      )}
    </header>

    <div class="field">
      <label for="contact-name">{fields.name.label}</label>
      <input
        id="contact-name"
        name="name"
        type="text"
        autocomplete="name"
        required
        minlength="2"
        maxlength="80"
        aria-describedby="contact-name-error"
        data-error={fields.name.error}
      />
      <p id="contact-name-error" class="error" hidden></p>
    </div>

    <div class="field">
      <label for="contact-phone">{fields.phone.label}</label>
      <p id="contact-phone-hint" class="hint">
        {fields.phone.hint}
      </p>
      <input
        id="contact-phone"
        name="phone"
        type="tel"
        autocomplete="tel"
        required
        pattern="\+?[\d \(\)\-]{9,20}"
        aria-describedby="contact-phone-hint contact-phone-error"
        data-error={fields.phone.error}
      />
      <p id="contact-phone-error" class="error" hidden></p>
    </div>

    <div class="pair">
      <div class="field">
        <label for="contact-city">{fields.city.label}</label>
        <input
          id="contact-city"
          name="city"
          type="text"
          autocomplete="address-level2"
          required
          maxlength="80"
          aria-describedby="contact-city-error"
          data-error={fields.city.error}
        />
        <p id="contact-city-error" class="error" hidden></p>
      </div>

      <div class="field">
        <label for="contact-heat-source">{fields.heatSource.label}</label>
        <select
          id="contact-heat-source"
          name="heatSource"
          required
          aria-describedby="contact-heat-source-error"
          data-error={fields.heatSource.error}
        >
          <option value="">{fields.heatSource.placeholder}</option>
          {heatSources.map((source) => (
            <option value={source}>{source}</option>
          ))}
        </select>
        <p id="contact-heat-source-error" class="error" hidden></p>
      </div>
    </div>

    <fieldset class="boiler-room">
      <legend>
        {fields.boilerRoom.legend} <span class="optional">{contactForm.optional}</span>
      </legend>
      <p class="boiler-text">{fields.boilerRoom.text}</p>

      <div class="field">
        <label for="contact-dimensions">{fields.dimensions.label}</label>
        <p id="contact-dimensions-hint" class="hint">
          {fields.dimensions.hint}
        </p>
        <input
          id="contact-dimensions"
          name="dimensions"
          type="text"
          maxlength="120"
          aria-describedby="contact-dimensions-hint"
        />
      </div>

      <div class="field">
        <label for="contact-photos">{fields.photos.label}</label>
        <p id="contact-photos-hint" class="hint">
          {fields.photos.hint}
        </p>
        <input
          id="contact-photos"
          class="photos-input visually-hidden"
          name="photos"
          type="file"
          accept={["image/*", ...photoLimits.extensions].join(",")}
          multiple
          aria-describedby="contact-photos-hint contact-photos-error"
          data-error={fields.photos.error}
        />
        <!-- A second, decorative label: the whole area opens the file picker and accepts dropped files. -->
        <label for="contact-photos" class="dropzone" aria-hidden="true" data-dropzone>
          <svg class="camera" viewBox="0 0 24 24" width="28" height="28">
            <path d="M4 8.5A1.5 1.5 0 0 1 5.5 7h2.2l1.5-2h5.6l1.5 2h2.2A1.5 1.5 0 0 1 20 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 17.5Z"></path>
            <circle cx="12" cy="13" r="3.5"></circle>
          </svg>
          <span class="choose">{fields.photos.choose}</span>
          <span class="summary" data-files-summary>
            {fields.photos.empty}
          </span>
        </label>
        <ul class="files" role="list" data-files hidden></ul>
        <p id="contact-photos-error" class="error" hidden></p>
      </div>
    </fieldset>

    <div class="field">
      <label for="contact-message">
        {fields.message.label} <span class="optional">{contactForm.optional}</span>
      </label>
      <textarea id="contact-message" name="message" rows="4" maxlength="2000"></textarea>
    </div>

    <div class="trap" aria-hidden="true">
      <label for="contact-website">{fields.honeypot.label}</label>
      <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="field">
      <div class="check">
        <input
          id="contact-consent"
          name="consent"
          type="checkbox"
          value="tak"
          required
          aria-describedby="contact-consent-error"
          data-error={fields.consent.error}
        />
        <label for="contact-consent">
          {fields.consent.label} <a href={privacyPolicyLink.href}>{fields.consent.linkLabel}</a>.
        </label>
      </div>
      <p id="contact-consent-error" class="error" hidden></p>
    </div>

    <Button type="submit" arrow class="submit">
      <span data-submit-label>{contactForm.submit}</span>
    </Button>

    <p class="status" role="status" aria-live="polite" data-status></p>
    <template data-failure>
      {contactForm.failure} <a href={phoneHref}>{primaryContact.phone}</a>
    </template>
    <template data-not-connected>
      {contactForm.notConnected.status} <a href={phoneHref}>{primaryContact.phone}</a>
      {site.email && (
        <>
          {" "}
          {contactForm.notConnected.orEmail} <a href={emailHref}>{site.email}</a>
        </>
      )}
    </template>
  </form>

  <section class="success" aria-labelledby="contact-success-title" hidden data-success>
    <span class="success-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="32" height="32">
        <path d="M5 12.5l4.5 4.5L19 7.5"></path>
      </svg>
    </span>
    <h2 id="contact-success-title" tabindex="-1">
      {success.title}
    </h2>
    <p class="success-text">{success.text}</p>
    <div class="urgent">
      <p class="urgent-title">{success.urgent}</p>
      <ul class="numbers" role="list">
        {site.contacts.map((contact, index) => (
          <li>
            <span class="person">{contact.name}</span>
            <Button
              variant={index === 0 ? "primary" : "dark"}
              href={telHref(contact.phone)}
              class="call"
            >
              <PhoneIcon />
              <span class="visually-hidden">Zadzwoń do: {contact.name},</span>
              {contact.phone}
            </Button>
          </li>
        ))}
      </ul>
    </div>
    <Button variant="outline" class="again">
      {success.again}
    </Button>
  </section>
</div>

<script>
  import { contactForm, photoLimits } from "../content/contact";

  type Field = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
  type Tone = "ok" | "error" | "info";

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const successPanel = document.querySelector<HTMLElement>("[data-success]");

  if (form) {
    const status = form.querySelector<HTMLElement>("[data-status]");
    const failure = form.querySelector<HTMLTemplateElement>("[data-failure]");
    const notConnected = form.querySelector<HTMLTemplateElement>("[data-not-connected]");
    const honeypot = form.querySelector<HTMLInputElement>("[name=website]");
    const submit = form.querySelector<HTMLButtonElement>("button[type=submit]");
    const submitLabel = form.querySelector<HTMLElement>("[data-submit-label]");
    const fields = Array.from(form.querySelectorAll<Field>("[data-error]"));
    const photos = form.querySelector<HTMLInputElement>("input[type=file]");
    const dropzone = form.querySelector<HTMLElement>("[data-dropzone]");
    const fileList = form.querySelector<HTMLUListElement>("[data-files]");
    const fileSummary = form.querySelector<HTMLElement>("[data-files-summary]");
    const isTextInput = (field: Field) =>
      field instanceof HTMLInputElement && field.type !== "checkbox" && field.type !== "file";

    form.noValidate = true;

    // Phones often save photos as HEIC with an empty MIME type, so the extension decides as well.
    const isPhoto = (file: File) =>
      file.type.startsWith("image/") ||
      photoLimits.extensions.some((extension) => file.name.toLowerCase().endsWith(extension));

    const photosAreValid = (input: HTMLInputElement) => {
      const files = Array.from(input.files ?? []);
      return (
        files.length <= photoLimits.maxFiles &&
        files.every((file) => isPhoto(file) && file.size <= photoLimits.maxBytes)
      );
    };

    const isValid = (field: Field) => {
      if (field instanceof HTMLInputElement && field.type === "file") return photosAreValid(field);
      if (isTextInput(field)) field.value = field.value.trim();
      if (field.name === "phone" && field.value !== "") {
        const digits = field.value.replace(/\D/g, "").length;
        if (digits < 9 || digits > 15) return false;
      }
      return field.checkValidity();
    };

    const showError = (field: Field, visible: boolean) => {
      const message = document.getElementById(`${field.id}-error`);
      field.setAttribute("aria-invalid", String(visible));
      if (message) {
        message.textContent = visible ? (field.dataset.error ?? "") : "";
        message.hidden = !visible;
      }
    };

    const setStatus = (content: string | Node, tone: Tone) => {
      if (!status) return;
      status.replaceChildren(content);
      status.dataset.tone = tone;
    };

    const setSending = (sending: boolean) => {
      if (submit) submit.disabled = sending;
      if (submitLabel) {
        submitLabel.textContent = sending ? contactForm.sending : contactForm.submit;
      }
    };

    const formatSize = (bytes: number) =>
      bytes < 1024 * 1024
        ? `${Math.max(1, Math.round(bytes / 1024))} KB`
        : `${(bytes / 1024 / 1024).toFixed(1).replace(".", ",")} MB`;

    // The file picker replaces the selection, so the form keeps its own list and adds new picks to it.
    let selected: File[] = [];
    let syncing = false;
    const sameFile = (a: File, b: File) =>
      a.name === b.name && a.size === b.size && a.lastModified === b.lastModified;

    const setPhotos = (files: File[]) => {
      if (!photos) return;
      selected = files.filter(
        (file, index) => files.findIndex((other) => sameFile(file, other)) === index,
      );
      const transfer = new DataTransfer();
      for (const file of selected) transfer.items.add(file);
      syncing = true;
      photos.files = transfer.files;
      photos.dispatchEvent(new Event("change"));
      syncing = false;
    };

    // Names come from the visitor's device, so they are only ever set as text.
    const renderPhotos = () => {
      if (!photos || !fileList || !fileSummary) return;
      const files = Array.from(photos.files ?? []);
      fileSummary.textContent =
        files.length === 0
          ? contactForm.fields.photos.empty
          : `Wybrano: ${files.length} z ${photoLimits.maxFiles}`;
      fileList.hidden = files.length === 0;
      fileList.replaceChildren(
        ...files.map((file, index) => {
          const item = document.createElement("li");
          const name = document.createElement("span");
          name.className = "file-name";
          name.textContent = file.name;
          const size = document.createElement("span");
          size.className = "file-size";
          size.textContent = formatSize(file.size);
          const remove = document.createElement("button");
          remove.type = "button";
          remove.className = "file-remove";
          remove.textContent = "Usuń";
          remove.setAttribute("aria-label", `Usuń zdjęcie ${file.name}`);
          remove.addEventListener("click", () => {
            setPhotos(files.filter((_, other) => other !== index));
            photos.focus();
          });
          if (!isPhoto(file) || file.size > photoLimits.maxBytes) item.dataset.invalid = "";
          item.append(name, size, remove);
          return item;
        }),
      );
    };

    photos?.addEventListener("change", () => {
      if (!syncing) {
        setPhotos([...selected, ...Array.from(photos.files ?? [])]);
        return;
      }
      renderPhotos();
      showError(photos, !isValid(photos));
    });

    if (dropzone && photos) {
      for (const type of ["dragenter", "dragover"]) {
        dropzone.addEventListener(type, (event) => {
          event.preventDefault();
          dropzone.dataset.dragover = "";
        });
      }
      dropzone.addEventListener("dragleave", () => delete dropzone.dataset.dragover);
      dropzone.addEventListener("drop", (event) => {
        event.preventDefault();
        delete dropzone.dataset.dragover;
        setPhotos([...selected, ...Array.from(event.dataTransfer?.files ?? [])]);
      });
    }

    for (const field of fields) {
      if (field === photos) continue;
      field.addEventListener(isTextInput(field) ? "blur" : "change", () => {
        if (field.hasAttribute("aria-invalid")) showError(field, !isValid(field));
      });
      field.addEventListener("input", () => {
        if (field.getAttribute("aria-invalid") === "true" && isValid(field)) {
          showError(field, false);
        }
      });
    }

    const resetForm = () => {
      form.reset();
      setPhotos([]);
      for (const field of fields) field.removeAttribute("aria-invalid");
      status?.replaceChildren();
    };

    const showSuccess = () => {
      if (!successPanel) {
        setStatus(contactForm.success.title, "ok");
        return;
      }
      form.hidden = true;
      successPanel.hidden = false;
      // The panel is much shorter than the form, so bring the card back into view before focusing it.
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      successPanel.closest(".contact-card")?.scrollIntoView({
        behavior: reducedMotion ? "auto" : "smooth",
        block: "start",
      });
      successPanel.querySelector<HTMLElement>("h2")?.focus({ preventScroll: true });
    };

    successPanel?.querySelector(".again")?.addEventListener("click", () => {
      successPanel.hidden = true;
      form.hidden = false;
      form.querySelector<HTMLInputElement>("#contact-name")?.focus();
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const invalid = fields.filter((field) => !isValid(field));
      for (const field of fields) showError(field, invalid.includes(field));

      if (invalid.length > 0) {
        setStatus(contactForm.invalid, "error");
        invalid[0]?.focus();
        return;
      }

      // Bots fill every field, people never see this one: pretend success and send nothing.
      if (honeypot && honeypot.value !== "") {
        resetForm();
        showSuccess();
        return;
      }

      if (!form.hasAttribute("data-connected")) {
        setStatus(
          notConnected ? notConnected.content.cloneNode(true) : contactForm.notConnected.status,
          "info",
        );
        return;
      }

      setSending(true);
      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        resetForm();
        showSuccess();
      } catch {
        setStatus(failure ? failure.content.cloneNode(true) : contactForm.failure, "error");
      } finally {
        setSending(false);
      }
    });
  }
</script>

<style>
  .contact-card {
    /* Inner padding; the boiler room panel bleeds to the card edge on phones, so it reads the same value. */
    --card-padding: var(--space-m);

    position: relative;
    padding: var(--space-l) var(--card-padding);
    border: 1px solid var(--color-line);
    border-radius: calc(var(--radius) + var(--space-s));
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .contact-form {
    container-type: inline-size;
    display: grid;
    gap: var(--space-m);
  }

  /* The form, the file list and the thank-you panel are switched with the hidden attribute. */
  .contact-form[hidden],
  .files[hidden] {
    display: none;
  }

  .intro {
    display: grid;
    gap: var(--space-xs);
    padding-block-end: var(--space-m);
    border-block-end: 1px solid var(--color-line);
  }

  .eyebrow {
    display: inline-flex;
    gap: var(--space-xs);
    align-items: center;
    color: var(--color-accent-text);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    content: "";
    inline-size: 1.5rem;
    block-size: 2px;
    background: var(--color-accent);
  }

  h2 {
    font-size: var(--text-2xl);
    line-height: 1.2;
  }

  .note,
  .hint,
  .optional {
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 400;
  }

  .pending {
    margin-block-start: var(--space-2xs);
    padding: var(--space-s) var(--space-m);
    border-inline-start: 4px solid var(--color-accent);
    border-radius: var(--radius-sm);
    background: var(--color-subtle);
    font-size: var(--text-sm);
  }

  .pending a,
  .status a {
    font-weight: 600;
    white-space: nowrap;
  }

  .field {
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
  }

  .pair {
    display: grid;
    gap: var(--space-m);
  }

  label {
    font-weight: 600;
  }

  input:not([type="checkbox"], [type="file"]),
  select,
  textarea {
    inline-size: 100%;
    min-block-size: var(--target-size);
    padding: var(--space-xs) var(--space-s);
    border: 1px solid var(--color-field);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-ink);
    font: inherit;
    transition: border-color 150ms ease;
  }

  input:not([type="checkbox"], [type="file"]):hover,
  select:hover,
  textarea:hover {
    border-color: var(--color-navy);
  }

  textarea {
    resize: vertical;
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline-offset: 1px;
  }

  [aria-invalid="true"] {
    border-color: var(--color-accent-text);
    box-shadow: inset 4px 0 0 var(--color-accent-text);
  }

  .error {
    color: var(--color-accent-text);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  /* Boiler room: optional details grouped on a tinted panel. */
  /* On phones the panel spans the full card width, so its fields line up with the fields above and below. */
  .boiler-room {
    display: grid;
    gap: var(--space-m);
    margin: 0 calc(var(--card-padding) * -1);
    padding: var(--space-m) var(--card-padding);
    border: 0;
    background: var(--color-subtle);
  }

  .boiler-room legend {
    float: inline-start;
    inline-size: 100%;
    padding: 0;
    color: var(--color-blue);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .boiler-room legend .optional {
    font-family: var(--font-base);
    letter-spacing: 0;
    text-transform: none;
  }

  .boiler-text {
    font-size: var(--text-sm);
  }

  .dropzone {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-s);
    align-items: center;
    padding: var(--space-m);
    border: 1.5px dashed var(--color-field);
    border-radius: var(--radius);
    background: var(--color-surface);
    font-weight: 400;
    cursor: pointer;
    transition:
      border-color 150ms ease,
      background-color 150ms ease;
  }

  .dropzone:hover,
  .dropzone[data-dragover] {
    border-color: var(--color-navy);
    background: var(--color-sea);
  }

  .photos-input:focus-visible + .dropzone {
    outline: 3px solid var(--color-navy);
    outline-offset: 3px;
  }

  .photos-input[aria-invalid="true"] + .dropzone {
    border-color: var(--color-accent-text);
  }

  .camera {
    flex: none;
    fill: none;
    stroke: var(--color-accent-text);
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  .choose {
    padding: var(--space-2xs) var(--space-m);
    border: 1.5px solid var(--color-navy);
    border-radius: var(--radius-pill);
    color: var(--color-navy);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .summary {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .files {
    display: grid;
    gap: var(--space-2xs);
  }

  .files :global(li) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: var(--space-s);
    align-items: center;
    padding: var(--space-2xs) var(--space-2xs) var(--space-2xs) var(--space-s);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    font-size: var(--text-sm);
  }

  .files :global(li[data-invalid]) {
    border-color: var(--color-accent-text);
  }

  .files :global(.file-name) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .files :global(.file-size) {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .files :global(.file-remove) {
    min-block-size: var(--target-size);
    padding-inline: var(--space-s);
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-accent-text);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .files :global(.file-remove:hover) {
    background: var(--color-subtle);
  }

  .check {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: var(--space-s);
    align-items: start;
  }

  .check input {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    margin: var(--space-xs) 0 0;
    accent-color: var(--color-navy);
  }

  .check label {
    padding-block: var(--space-xs);
    font-size: var(--text-sm);
    font-weight: 400;
  }

  .check input[aria-invalid="true"] {
    box-shadow: none;
    outline: 2px solid var(--color-accent-text);
  }

  .trap {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .submit {
    justify-self: stretch;
    min-block-size: 3.25rem;
  }

  .status {
