---
import { contactForm, heatSources } from "../content/contact";
import { privacyPolicyLink } from "../content/navigation";
import { phoneHref, primaryContact } from "../content/site";
import { formEndpoint } from "../lib/env";
import Button from "./Button.astro";

const { fields } = contactForm;
const isDemoForm = formEndpoint === "";
---

<form
  class="contact-form"
  method="post"
  action={isDemoForm ? undefined : formEndpoint}
  aria-labelledby="contact-form-title"
  data-contact-form
  data-demo={isDemoForm ? "true" : undefined}
>
  <h2 id="contact-form-title">{contactForm.title}</h2>
  <p class="note">{contactForm.requiredNote}</p>

  <div class="field">
    <label for="contact-name">{fields.name.label}</label>
    <input
      id="contact-name"
      name="name"
      type="text"
      autocomplete="name"
      required
      minlength="2"
      maxlength="80"
      aria-describedby="contact-name-error"
      data-error={fields.name.error}
    />
    <p id="contact-name-error" class="error" hidden></p>
  </div>

  <div class="field">
    <label for="contact-phone">{fields.phone.label}</label>
    <p id="contact-phone-hint" class="hint">
      {fields.phone.hint}
    </p>
    <input
      id="contact-phone"
      name="phone"
      type="tel"
      autocomplete="tel"
      required
      pattern="\+?[\d \(\)\-]{9,20}"
      aria-describedby="contact-phone-hint contact-phone-error"
      data-error={fields.phone.error}
    />
    <p id="contact-phone-error" class="error" hidden></p>
  </div>

  <div class="field">
    <label for="contact-city">{fields.city.label}</label>
    <input
      id="contact-city"
      name="city"
      type="text"
      autocomplete="address-level2"
      required
      maxlength="80"
      aria-describedby="contact-city-error"
      data-error={fields.city.error}
    />
    <p id="contact-city-error" class="error" hidden></p>
  </div>

  <div class="field">
    <label for="contact-heat-source">{fields.heatSource.label}</label>
    <select
      id="contact-heat-source"
      name="heatSource"
      required
      aria-describedby="contact-heat-source-error"
      data-error={fields.heatSource.error}
    >
      <option value="">{fields.heatSource.placeholder}</option>
      {heatSources.map((source) => (
        <option value={source}>{source}</option>
      ))}
    </select>
    <p id="contact-heat-source-error" class="error" hidden></p>
  </div>

  <div class="field">
    <label for="contact-message">
      {fields.message.label} <span class="optional">{fields.message.optional}</span>
    </label>
    <textarea id="contact-message" name="message" rows="4" maxlength="2000"></textarea>
  </div>

  <div class="trap" aria-hidden="true">
    <label for="contact-website">{fields.honeypot.label}</label>
    <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="field">
    <div class="check">
      <input
        id="contact-consent"
        name="consent"
        type="checkbox"
        value="tak"
        required
        aria-describedby="contact-consent-error"
        data-error={fields.consent.error}
      />
      <label for="contact-consent">
        {fields.consent.label} <a href={privacyPolicyLink.href}>{fields.consent.linkLabel}</a>.
      </label>
    </div>
    <p id="contact-consent-error" class="error" hidden></p>
  </div>

  <Button type="submit" arrow class="submit">
    <span data-submit-label>{contactForm.submit}</span>
  </Button>

  {isDemoForm && <p class="demo">{contactForm.demo}</p>}

  <p class="status" role="status" aria-live="polite" data-status></p>
  <template data-failure>
    {contactForm.failure} <a href={phoneHref}>{primaryContact.phone}</a>
  </template>
</form>

<script>
  import { contactForm } from "../content/contact";

  type Field = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
  type Tone = "ok" | "error" | "info";

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");

  if (form) {
    const status = form.querySelector<HTMLElement>("[data-status]");
    const failure = form.querySelector<HTMLTemplateElement>("[data-failure]");
    const submit = form.querySelector<HTMLButtonElement>("button[type=submit]");
    const submitLabel = form.querySelector<HTMLElement>("[data-submit-label]");
    const fields = Array.from(form.querySelectorAll<Field>("[data-error]"));
    const isDemoForm = form.dataset.demo === "true";
    const isTextInput = (field: Field) =>
      field instanceof HTMLInputElement && field.type !== "checkbox";

    form.noValidate = true;

    const isValid = (field: Field) => {
      if (isTextInput(field)) field.value = field.value.trim();
      if (field.name === "phone" && field.value !== "") {
        const digits = field.value.replace(/\D/g, "").length;
        if (digits < 9 || digits > 15) return false;
      }
      return field.checkValidity();
    };

    const showError = (field: Field, visible: boolean) => {
      const message = document.getElementById(`${field.id}-error`);
      field.setAttribute("aria-invalid", String(visible));
      if (message) {
        message.textContent = visible ? (field.dataset.error ?? "") : "";
        message.hidden = !visible;
      }
    };

    const setStatus = (content: string | Node, tone: Tone) => {
      if (!status) return;
      status.replaceChildren(content);
      status.dataset.tone = tone;
    };

    const setSending = (sending: boolean) => {
      if (submit) submit.disabled = sending;
      if (submitLabel) {
        submitLabel.textContent = sending ? contactForm.sending : contactForm.submit;
      }
    };

    for (const field of fields) {
      field.addEventListener(isTextInput(field) ? "blur" : "change", () => {
        if (field.hasAttribute("aria-invalid")) showError(field, !isValid(field));
      });
      field.addEventListener("input", () => {
        if (field.getAttribute("aria-invalid") === "true" && isValid(field)) {
          showError(field, false);
        }
      });
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const invalid = fields.filter((field) => !isValid(field));
      for (const field of fields) showError(field, invalid.includes(field));

      if (invalid.length > 0) {
        setStatus(contactForm.invalid, "error");
        invalid[0]?.focus();
        return;
      }

      if (isDemoForm) {
        setStatus(contactForm.demo, "info");
        return;
      }

      setSending(true);
      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        form.reset();
        for (const field of fields) field.removeAttribute("aria-invalid");
        setStatus(contactForm.success, "ok");
      } catch {
        setStatus(failure ? failure.content.cloneNode(true) : contactForm.failure, "error");
      } finally {
        setSending(false);
      }
    });
  }
</script>

<style>
  .contact-form {
    position: relative;
    display: grid;
    gap: var(--space-m);
    padding: var(--space-l);
    border: 1px solid var(--color-line);
    border-block-start: 3px solid var(--color-navy);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  h2 {
    font-size: var(--text-xl);
  }

  .note,
  .hint,
  .optional {
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 400;
  }

  .field {
    display: grid;
    gap: var(--space-2xs);
  }

  label {
    font-weight: 600;
  }

  input:not([type="checkbox"]),
  select,
  textarea {
    inline-size: 100%;
    min-block-size: var(--target-size);
    padding: var(--space-xs) var(--space-s);
    border: 1px solid var(--color-field);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-ink);
    font: inherit;
  }

  textarea {
    resize: vertical;
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline-offset: 1px;
  }

  [aria-invalid="true"] {
    border-color: var(--color-accent);
    box-shadow: inset 4px 0 0 var(--color-accent);
  }

  .error {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .check {
    display: grid;
    grid-template-columns: var(--target-size) minmax(0, 1fr);
    align-items: start;
  }

  .check input {
    inline-size: 1.375rem;
    block-size: 1.375rem;
    margin: 0.6875rem;
    accent-color: var(--color-navy);
  }

  .check label {
    padding-block: var(--space-xs);
    font-size: var(--text-sm);
    font-weight: 400;
  }

  .check input[aria-invalid="true"] {
    box-shadow: none;
    outline: 2px solid var(--color-accent);
  }

  .trap {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .submit {
    justify-self: start;
  }

  .demo {
    padding: var(--space-s) var(--space-m);
    border: 1px dashed var(--color-field);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .status {
    padding: var(--space-s) var(--space-m);
    border-inline-start: 4px solid var(--color-navy);
    background: var(--color-subtle);
    font-weight: 600;
  }

  .status:empty {
    display: none;
  }

  .status[data-tone="error"] {
    border-inline-start-color: var(--color-accent);
  }
</style>
