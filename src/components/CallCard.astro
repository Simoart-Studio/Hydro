---
import { callCard } from "../content/contact";
import { site, telHref } from "../content/site";
import { preparation } from "../content/subsidies";
import Button from "./Button.astro";
import PhoneIcon from "./PhoneIcon.astro";
---

<section class="call-card" aria-labelledby="call-card-title">
  <h2 id="call-card-title">{callCard.title}</h2>
  <p class="text">{callCard.text}</p>
  <ul class="numbers" role="list">
    {site.contacts.map((contact, index) => (
      <li>
        <span class="person">{contact.name}</span>
        <Button
          variant={index === 0 ? "primary" : "dark"}
          href={telHref(contact.phone)}
          class="call"
        >
          <PhoneIcon />
          <span class="visually-hidden">Zadzwoń do: {contact.name},</span>
          {contact.phone}
        </Button>
      </li>
    ))}
  </ul>
  <h3>{callCard.preparationTitle}</h3>
  <ul class="checklist" role="list">
    {preparation.items.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
</section>

<style>
  .call-card {
    display: grid;
    gap: var(--space-m);
    padding: var(--space-l);
    border: 1px solid var(--color-line);
    border-block-start: 3px solid var(--color-navy);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  h2 {
    font-size: var(--text-xl);
  }

  .text {
    color: var(--color-muted);
  }

  .numbers {
    display: grid;
    gap: var(--space-s);
  }

  .numbers li {
    display: grid;
    gap: var(--space-2xs);
  }

  .person {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .call {
    justify-self: stretch;
    min-block-size: 3.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-lg);
  }

  h3 {
    margin-block-start: var(--space-xs);
    padding-block-start: var(--space-m);
    border-block-start: 1px solid var(--color-line);
    color: var(--color-blue);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .checklist {
    display: grid;
    gap: var(--space-xs);
  }

  .checklist li {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: var(--space-xs);
    font-size: var(--text-sm);
  }

  .checklist li::before {
    content: "+";
    color: var(--color-accent-text);
    font-family: var(--font-mono);
  }

  @media (width >= 30rem) {
    .call {
      justify-self: start;
      min-inline-size: 16rem;
    }
  }
</style>
