---
import { principlesSection, promises, refusals } from "../content/principles";
import ListColumns from "./ListColumns.astro";
import Section from "./Section.astro";
---

<Section id="zasady" title={principlesSection.title} intro={principlesSection.intro} tone="subtle">
  <ListColumns
    columns={[
      { title: principlesSection.promisesTitle, items: promises, marker: "plus" },
      { title: principlesSection.refusalsTitle, items: refusals, marker: "minus" },
    ]}
  />
</Section>
