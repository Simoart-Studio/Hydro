---
import { principlesSection, promises, refusals } from "../content/principles";
import Section from "./Section.astro";

const columns = [
  { title: principlesSection.promisesTitle, items: promises, kind: "promise" },
  { title: principlesSection.refusalsTitle, items: refusals, kind: "refusal" },
];
---

<Section id="zasady" title={principlesSection.title} intro={principlesSection.intro} tone="subtle">
  <div class="columns">
    {columns.map((column) => (
      <div class:list={["column", column.kind]}>
        <h3>{column.title}</h3>
        <ul role="list">
          {column.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Section>

<style>
  .columns {
    display: grid;
    gap: var(--space-l);
  }

  .column {
    display: grid;
    gap: var(--space-m);
    align-content: start;
    padding: var(--space-l);
    border-block-start: 4px solid var(--color-coral);
    background: var(--color-surface);
  }

  .refusal {
    border-block-start-color: var(--color-petrol);
  }

  ul {
    display: grid;
    gap: var(--space-s);
  }

  li {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: var(--space-xs);
  }

  li::before {
    font-weight: 700;
    line-height: inherit;
  }

  .promise li::before {
    content: "+";
    color: var(--color-coral-strong);
  }

  .refusal li::before {
    content: "–";
    color: var(--color-petrol-fg);
  }

  @media (width >= 40rem) {
    .columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
