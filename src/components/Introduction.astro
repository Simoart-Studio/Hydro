---
import { intro } from "../content/intro";
import { offerItems } from "../content/offer";
import Button from "./Button.astro";
import PhotoTile from "./PhotoTile.astro";
import Section from "./Section.astro";
import TileGrid from "./TileGrid.astro";
---

<Section id="o-firmie" title={intro.title} width="page">
  <div class="text">
    {intro.paragraphs.map((paragraph) => (
      <p set:html={paragraph} />
    ))}
    <Button href={intro.aboutLink.href} variant="outline" size="small" arrow class="about">
      {intro.aboutLink.label}
    </Button>
  </div>
  <p class="prompt">{intro.categoriesPrompt}</p>
  <TileGrid columns={4}>
    {offerItems.map((item) => (
      <li>
        <PhotoTile
          label={item.shortTitle}
          image={item.photo.src}
          alt={item.photo.caption}
          href={`/oferta#${item.id}`}
        />
      </li>
    ))}
  </TileGrid>
</Section>

<style>
  .text {
    display: grid;
    gap: var(--space-m);
    justify-items: center;
    max-inline-size: var(--measure);
    margin-inline: auto;
    text-align: center;
  }

  .about {
    margin-block-start: var(--space-xs);
  }

  .prompt {
    justify-self: center;
    margin-block-start: var(--space-l);
    color: var(--color-blue);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-align: center;
    text-transform: uppercase;
  }
</style>
