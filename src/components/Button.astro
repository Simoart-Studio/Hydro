---
interface Props {
  variant?: "primary" | "dark";
  size?: "regular" | "small";
  href?: string;
  type?: "button" | "submit";
  arrow?: boolean;
  class?: string;
}

const {
  variant = "primary",
  size = "regular",
  href,
  type = "button",
  arrow = false,
  class: className,
} = Astro.props;
const classes = ["button", variant, size, className];
---

{href ? (
  <a href={href} class:list={classes}>
    <slot />
    {arrow && <span class="arrow" aria-hidden="true" />}
  </a>
) : (
  <button type={type} class:list={classes}>
    <slot />
    {arrow && <span class="arrow" aria-hidden="true" />}
  </button>
)}

<style>
  .button {
    display: inline-flex;
    gap: var(--space-xs);
    align-items: center;
    justify-content: center;
    min-block-size: var(--target-size);
    padding: var(--space-xs) var(--space-l);
    border: 0;
    border-radius: var(--radius-pill);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 150ms ease;
  }

  .small {
    gap: var(--space-2xs);
    padding-inline: var(--space-s) var(--space-xs);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .primary {
    background: var(--color-coral-strong);
    color: var(--color-on-coral);
  }

  .primary:hover {
    background: color-mix(in srgb, var(--color-coral-strong) 85%, #000000);
  }

  .dark {
    background: var(--color-petrol);
    color: var(--color-on-petrol);
  }

  .dark:hover {
    background: color-mix(in srgb, var(--color-petrol) 85%, #000000);
  }

  .button:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .arrow {
    display: grid;
    flex: none;
    place-items: center;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    border-radius: 50%;
    background: color-mix(in srgb, currentColor 22%, transparent);
  }

  .arrow::before {
    content: "";
    inline-size: 0.35rem;
    block-size: 0.35rem;
    border-block-start: 2px solid currentColor;
    border-inline-end: 2px solid currentColor;
    translate: -1px 0;
    rotate: 45deg;
  }
</style>
