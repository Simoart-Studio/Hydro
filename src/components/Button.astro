---
interface Props {
  /**
   * primary: the one action a section asks for (red).
   * dark: phone numbers and solid secondary actions (navy).
   * outline: repeated or supporting actions, such as "Dowiedz się więcej" in a list.
   */
  variant?: "primary" | "dark" | "outline";
  size?: "regular" | "small";
  href?: string;
  type?: "button" | "submit";
  arrow?: boolean;
  class?: string;
}

const {
  variant = "primary",
  size = "regular",
  href,
  type = "button",
  arrow = false,
  class: className,
} = Astro.props;
const classes = ["button", variant, size, className];
---

{href ? (
  <a href={href} class:list={classes}>
    <slot />
    {arrow && <span class="arrow" aria-hidden="true" />}
  </a>
) : (
  <button type={type} class:list={classes}>
    <slot />
    {arrow && <span class="arrow" aria-hidden="true" />}
  </button>
)}

<style>
  .button {
    display: inline-flex;
    gap: var(--space-xs);
    align-items: center;
    justify-content: center;
    min-block-size: var(--target-size);
    padding: var(--space-xs) var(--space-l);
    border: 1.5px solid transparent;
    border-radius: var(--radius-pill);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 150ms ease,
      border-color 150ms ease,
      color 150ms ease;
  }

  .small {
    gap: var(--space-2xs);
    padding-inline: var(--space-m) var(--space-xs);
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .primary {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .primary:hover {
    background: var(--color-accent-hover);
  }

  .dark {
    background: var(--color-navy);
    color: var(--color-on-navy);
  }

  .dark:hover {
    background: var(--color-navy-hover);
  }

  .outline {
    border-color: var(--color-navy);
    background: transparent;
    color: var(--color-navy);
  }

  .outline:hover {
    background: var(--color-navy);
    color: var(--color-on-navy);
  }

  .button:active {
    translate: 0 1px;
  }

  .button:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .arrow {
    display: grid;
    flex: none;
    place-items: center;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    border-radius: 50%;
    background: color-mix(in srgb, currentColor 18%, transparent);
  }

  .arrow::before {
    content: "";
    inline-size: 0.35rem;
    block-size: 0.35rem;
    border-block-start: 2px solid currentColor;
    border-inline-end: 2px solid currentColor;
    translate: -1px 0;
    rotate: 45deg;
    transition: translate 150ms ease;
  }

  .button:hover .arrow::before {
    translate: 1px 0;
  }
</style>
