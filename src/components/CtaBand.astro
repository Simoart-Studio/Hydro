---
import { ctaBand } from "../content/contact";
import { phoneHref, primaryContact } from "../content/site";
import Button from "./Button.astro";
import Container from "./Container.astro";
import PhoneIcon from "./PhoneIcon.astro";
---

<section class="cta-band on-navy" aria-labelledby="cta-title">
  <Container width="column" class="inner">
    <h2 id="cta-title">{ctaBand.title}</h2>
    <p>{ctaBand.text}</p>
    <div class="actions">
      <Button href={ctaBand.action.href} arrow>
        {ctaBand.action.label}
      </Button>
      <Button variant="dark" href={phoneHref}>
        <PhoneIcon />
        <span class="visually-hidden">Zadzwoń:</span>
        {primaryContact.phone}
      </Button>
    </div>
  </Container>
</section>

<style>
  .cta-band {
    padding-block: var(--space-section);
    border-block-start: 4px solid var(--color-accent);
    background:
      radial-gradient(
        50rem 22rem at 50% 0%,
        color-mix(in srgb, #1675b9 34%, transparent),
        transparent 70%
      ),
      var(--surface-navy);
  }

  .inner {
    display: grid;
    gap: var(--space-m);
    justify-items: center;
    text-align: center;
  }

  p {
    max-inline-size: var(--measure);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    justify-content: center;
    margin-block-start: var(--space-xs);
  }
</style>
