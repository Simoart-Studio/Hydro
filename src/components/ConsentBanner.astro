---
import { privacyPolicyLink } from "../content/navigation";
import { googleTagId } from "../lib/env";
import Button from "./Button.astro";
---

{googleTagId && (
  <section
    class="consent"
    aria-labelledby="consent-title"
    hidden
    data-consent
    data-tag-id={googleTagId}
  >
    <div class="box">
      <h2 id="consent-title" class="title" tabindex="-1">
        Pliki cookies
      </h2>
      <p class="text">
        Za Twoją zgodą używamy plików cookies Google (Google Ads i Analytics), żeby sprawdzać, czy
        nasze reklamy docierają do osób, którym możemy pomóc. Bez zgody strona działa tak samo.
        Szczegóły: <a href={privacyPolicyLink.href}>{privacyPolicyLink.label}</a>.
      </p>
      <div class="actions">
        <Button variant="outline" size="small" data-consent-choice="denied">
          Odrzucam
        </Button>
        <Button size="small" data-consent-choice="granted">
          Akceptuję
        </Button>
      </div>
    </div>
  </section>
)}

<script>
  // Basic consent mode: no request goes to Google until the visitor accepts. The choice is kept in
  // localStorage (not a cookie), and "Ustawienia cookies" in the footer opens this banner again.
  // It is stored with the date it was made and the version of this text, and the banner asks again
  // after 12 months or when VERSION changes (raise it whenever the purposes or the tools change).
  const KEY = "hydro-consent-v1";
  const VERSION = 1;
  const MAX_AGE_MS = 365 * 24 * 60 * 60 * 1000;

  type Choice = "granted" | "denied";
  type ConsentRecord = { choice: Choice; version: number; date: string };
  const banner = document.querySelector<HTMLElement>("[data-consent]");
  const tagId = banner?.dataset.tagId ?? "";

  type Gtag = (...args: unknown[]) => void;
  const page = window as typeof window & { dataLayer?: unknown[]; gtag?: Gtag };

  /** The stored choice, or null when there is none, it is from an older version or older than 12 months. */
  const readChoice = (): Choice | null => {
    try {
      const record = JSON.parse(
        localStorage.getItem(KEY) ?? "null",
      ) as Partial<ConsentRecord> | null;
      if (!record || (record.choice !== "granted" && record.choice !== "denied")) return null;
      const age = Date.now() - Date.parse(record.date ?? "");
      if (record.version !== VERSION || !(age >= 0 && age < MAX_AGE_MS)) return null;
      return record.choice;
    } catch {
      return null;
    }
  };

  const saveChoice = (choice: Choice) => {
    const record: ConsentRecord = { choice, version: VERSION, date: new Date().toISOString() };
    try {
      localStorage.setItem(KEY, JSON.stringify(record));
    } catch {
      // Private mode: the choice lasts until the page is closed.
    }
  };

  const loadTag = () => {
    if (page.gtag || !tagId) return;
    page.dataLayer = page.dataLayer ?? [];
    page.gtag = function gtag() {
      // gtag.js reads the arguments object itself, not an array.
      // eslint-disable-next-line prefer-rest-params
      page.dataLayer?.push(arguments);
    };
    page.gtag("consent", "default", {
      ad_storage: "granted",
      ad_user_data: "granted",
      ad_personalization: "granted",
      analytics_storage: "granted",
    });
    page.gtag("js", new Date());
    page.gtag("config", tagId);
    const script = document.createElement("script");
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(tagId)}`;
    document.head.append(script);
  };

  // Withdrawing consent stops further measurement and removes the cookies Google set on this domain.
  const revoke = () => {
    page.gtag?.("consent", "update", {
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied",
      analytics_storage: "denied",
    });
    for (const cookie of document.cookie.split(";")) {
      const name = cookie.split("=")[0]?.trim() ?? "";
      if (/^(_ga|_gid|_gcl|_gac)/.test(name)) {
        for (const domain of [
          "",
          `; domain=${location.hostname}`,
          `; domain=.${location.hostname}`,
        ]) {
          document.cookie = `${name}=; max-age=0; path=/${domain}`;
        }
      }
    }
  };

  const show = () => {
    if (!banner) return;
    banner.hidden = false;
    // Focus goes to the title, not to either button, so neither choice is pre-selected.
    banner.querySelector<HTMLElement>("#consent-title")?.focus({ preventScroll: true });
  };

  if (banner) {
    const choice = readChoice();
    if (choice === "granted") loadTag();
    else if (choice !== "denied") banner.hidden = false;

    for (const button of banner.querySelectorAll<HTMLElement>("[data-consent-choice]")) {
      button.addEventListener("click", () => {
        const choice: Choice = button.dataset.consentChoice === "granted" ? "granted" : "denied";
        saveChoice(choice);
        banner.hidden = true;
        if (choice === "granted") loadTag();
        else revoke();
      });
    }

    for (const opener of document.querySelectorAll("[data-consent-open]")) {
      opener.addEventListener("click", show);
    }

    // Conversions for Google Ads: a tap on a phone number and a sent contact form.
    document.addEventListener("click", (event) => {
      const link = (event.target as Element | null)?.closest?.("a[href^='tel:']");
      if (link) page.gtag?.("event", "click_to_call", { link_url: link.getAttribute("href") });
    });
    document.addEventListener("hydro:lead", () => page.gtag?.("event", "generate_lead"));
  } else {
    // Without a tag the footer link has nothing to open.
    for (const opener of document.querySelectorAll<HTMLElement>("[data-consent-open]")) {
      opener.hidden = true;
    }
  }
</script>

<style>
  .consent {
    position: fixed;
    z-index: 50;
    inset-inline: var(--space-s);
    inset-block-end: var(--space-s);
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .box {
    display: grid;
    gap: var(--space-s);
    max-inline-size: 40rem;
    padding: var(--space-m);
    border: 1px solid var(--color-line);
    border-radius: calc(var(--radius) + var(--space-2xs));
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    pointer-events: auto;
  }

  .title {
    font-size: var(--text-base);
  }

  /* The title only receives focus from script, to move the reader to the banner. */
  .title:focus {
    outline: none;
  }

  .text {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .text a {
    color: var(--color-ink);
  }

  /* Both choices are equally easy: same size, side by side. */
  .actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xs);
  }

  .actions :global(.button) {
    justify-content: center;
  }

  @media (width >= 40rem) {
    .consent {
      inset-block-end: var(--space-m);
    }

    .box {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      padding: var(--space-m) var(--space-l);
    }

    .title,
    .text {
      grid-column: 1;
    }

    .actions {
      grid-column: 2;
      grid-row: 1 / span 2;
      grid-template-columns: repeat(2, auto);
    }
  }
</style>
