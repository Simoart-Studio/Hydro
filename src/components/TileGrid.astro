---
interface Props {
  id?: string;
  columns?: 3 | 4;
}

const { id, columns = 3 } = Astro.props;
---

<ul id={id} class:list={["tile-grid", `columns-${columns}`]} role="list">
  <slot />
</ul>

<style>
  .tile-grid {
    display: grid;
    gap: var(--space-xl) var(--space-l);
    scroll-margin-block-start: var(--space-xl);
  }

  @media (width >= 30rem) {
    .tile-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 48rem) {
    .columns-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (width >= 60rem) {
    .columns-4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
