---
import { eligibilityLabels, eligibleDevices } from "../content/subsidies";

const { columns, items } = eligibleDevices;
---

<table class="eligibility">
  <caption class="visually-hidden">{eligibleDevices.caption}</caption>
  <thead>
    <tr>
      <th scope="col">{columns.device}</th>
      <th scope="col">{columns.eligibility}</th>
      <th scope="col">{columns.note}</th>
    </tr>
  </thead>
  <tbody>
    {items.map((item) => (
      <tr>
        <th scope="row">
          <a href={item.href}>{item.device}</a>
        </th>
        <td data-label={columns.eligibility}>
          <span class:list={["status", item.eligibility]}>
            {eligibilityLabels[item.eligibility]}
          </span>
        </td>
        <td data-label={columns.note}>{item.note}</td>
      </tr>
    ))}
  </tbody>
</table>

<style>
  .eligibility {
    inline-size: 100%;
    border-collapse: collapse;
    background: var(--color-surface);
  }

  thead {
    display: none;
  }

  tr {
    display: grid;
    gap: var(--space-xs);
    padding: var(--space-m);
    border: 1px solid var(--color-line);
  }

  tr + tr {
    border-block-start: 0;
  }

  th,
  td {
    text-align: start;
  }

  tbody th {
    font-size: var(--text-lg);
  }

  tbody th a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-size);
    text-decoration-color: var(--color-line);
  }

  tbody th a:hover {
    color: var(--color-coral-strong);
  }

  td {
    color: var(--color-muted);
  }

  .status {
    display: inline-flex;
    gap: var(--space-xs);
    align-items: center;
    color: var(--color-ink);
    font-weight: 600;
  }

  .status::before {
    content: "";
    flex: none;
    inline-size: 0.625rem;
    block-size: 0.625rem;
    border-radius: 50%;
  }

  .yes::before {
    background: var(--color-return);
  }

  .conditional::before {
    border: 2px solid var(--color-return);
  }

  @media (width >= 48rem) {
    .eligibility {
      display: table;
      border: 1px solid var(--color-line);
    }

    thead {
      display: table-header-group;
    }

    tr {
      display: table-row;
      padding: 0;
      border: 0;
    }

    th,
    td {
      padding: var(--space-s) var(--space-m);
      border-block-end: 1px solid var(--color-line);
      vertical-align: middle;
    }

    thead th {
      background: var(--color-subtle);
      color: var(--color-petrol);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    tbody th {
      font-size: var(--text-base);
    }

    tbody tr:last-child > * {
      border-block-end: 0;
    }
  }
</style>
