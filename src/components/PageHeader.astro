---
import Container from "./Container.astro";

interface Props {
  title: string;
  lead?: string;
}

const { title, lead } = Astro.props;
---

<div class="page-header on-navy">
  <Container width="column" class="inner">
    <nav aria-label="Ścieżka">
      <ol class="breadcrumbs" role="list">
        <li>
          <a href="/">Strona główna</a>
        </li>
        <li aria-current="page">{title}</li>
      </ol>
    </nav>
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </Container>
</div>

<style>
  .page-header {
    position: relative;
    padding-block: var(--space-xl) var(--space-2xl);
    overflow: hidden;
    /* Navy like the home hero: a blueprint grid, blue light from the right and a warm glow from the left. */
    background:
      radial-gradient(
        50rem 26rem at 100% 0%,
        color-mix(in srgb, #1675b9 38%, transparent),
        transparent 70%
      ),
      radial-gradient(
        36rem 20rem at 0% 100%,
        color-mix(in srgb, #f28c28 16%, transparent),
        transparent 70%
      ),
      linear-gradient(color-mix(in srgb, #ffffff 5%, transparent) 1px, transparent 1px) 0 0 / 24px
        24px,
      linear-gradient(90deg, color-mix(in srgb, #ffffff 5%, transparent) 1px, transparent 1px) 0 0 /
        24px 24px,
      var(--surface-navy);
  }

  .inner {
    display: grid;
    gap: var(--space-m);
    justify-items: center;
    text-align: center;
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .breadcrumbs li + li::before {
    content: "/";
    margin-inline: var(--space-xs);
  }

  .breadcrumbs a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-size);
    color: var(--color-ink);
  }

  .breadcrumbs li {
    display: flex;
    align-items: center;
  }

  h1 {
    color: var(--color-ink);
  }

  h1::after {
    content: "";
    display: block;
    inline-size: 2.5rem;
    block-size: 3px;
    margin: var(--space-s) auto 0;
    background: var(--color-accent);
  }

  .lead {
    max-inline-size: var(--measure);
    color: var(--color-muted);
    font-size: var(--text-lg);
  }

  .page-header::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: 3px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-accent) 30%,
      var(--color-accent) 70%,
      transparent
    );
    opacity: 0.8;
  }
</style>
