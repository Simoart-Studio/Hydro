---
import { getImage, Image } from "astro:assets";
import type { Photo } from "../content/gallery";

interface Props {
  photos: Photo[];
  /** Widok podglądu na stronie głównej: cztery kolumny na szerokim ekranie. */
  compact?: boolean;
}

const { photos, compact = false } = Astro.props;

// The link points at a large WebP, so the photo opens without JavaScript and the lightbox reuses it.
const items = await Promise.all(
  photos.map(async (photo) => {
    const full = await getImage({
      src: photo.src,
      width: Math.min(1600, photo.src.width),
      format: "webp",
    });
    return { ...photo, fullSrc: full.src };
  }),
);
---

<ul class:list={["gallery", { compact }]} role="list">
  {items.map((item) => (
    <li>
      <figure>
        <a
          class="frame"
          href={item.fullSrc}
          data-lightbox
          data-caption={item.caption}
          aria-label={`Powiększ zdjęcie: ${item.caption}`}
        >
          <Image
            class="photo"
            src={item.src}
            alt={item.caption}
            widths={[320, 480, 720]}
            sizes={
              compact
                ? "(min-width: 64rem) 17rem, (min-width: 48rem) 30vw, 46vw"
                : "(min-width: 64rem) 22rem, (min-width: 48rem) 30vw, 46vw"
            }
          />
          <span class="zoom" aria-hidden="true"></span>
        </a>
        <figcaption>{item.caption}</figcaption>
      </figure>
    </li>
  ))}
</ul>

<script>
  const triggers = Array.from(document.querySelectorAll<HTMLAnchorElement>("a[data-lightbox]"));

  if (triggers.length > 0) {
    const dialog = document.createElement("dialog");
    dialog.className = "lightbox";
    dialog.setAttribute("aria-label", "Podgląd zdjęcia");
    dialog.innerHTML = `
      <figure class="lightbox-figure">
        <img class="lightbox-image" alt="" />
        <figcaption class="lightbox-caption">
          <span class="lightbox-counter"></span>
          <span class="lightbox-text"></span>
        </figcaption>
      </figure>
      <button type="button" class="lightbox-button lightbox-close" aria-label="Zamknij podgląd">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
      <button type="button" class="lightbox-button lightbox-prev" aria-label="Poprzednie zdjęcie">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
      </button>
      <button type="button" class="lightbox-button lightbox-next" aria-label="Następne zdjęcie">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
      </button>
    `;
    document.body.append(dialog);

    const image = dialog.querySelector<HTMLImageElement>(".lightbox-image")!;
    const counter = dialog.querySelector<HTMLElement>(".lightbox-counter")!;
    const text = dialog.querySelector<HTMLElement>(".lightbox-text")!;
    let current = 0;
    let opener: HTMLElement | null = null;

    const show = (index: number) => {
      current = (index + triggers.length) % triggers.length;
      const trigger = triggers[current]!;
      const caption = trigger.dataset.caption ?? "";
      image.src = trigger.href;
      image.alt = caption;
      counter.textContent = `${current + 1} / ${triggers.length}`;
      text.textContent = caption;
    };

    triggers.forEach((trigger, index) => {
      trigger.addEventListener("click", (event) => {
        event.preventDefault();
        opener = trigger;
        show(index);
        dialog.showModal();
      });
    });

    dialog.querySelector(".lightbox-close")!.addEventListener("click", () => dialog.close());
    dialog.querySelector(".lightbox-prev")!.addEventListener("click", () => show(current - 1));
    dialog.querySelector(".lightbox-next")!.addEventListener("click", () => show(current + 1));

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") show(current - 1);
      if (event.key === "ArrowRight") show(current + 1);
    });

    let touchStart: number | null = null;
    dialog.addEventListener("touchstart", (event) => {
      touchStart = event.touches[0]?.clientX ?? null;
    });
    dialog.addEventListener("touchend", (event) => {
      const end = event.changedTouches[0]?.clientX;
      if (touchStart === null || end === undefined) return;
      const distance = end - touchStart;
      if (Math.abs(distance) > 50) show(current + (distance < 0 ? 1 : -1));
      touchStart = null;
    });

    dialog.addEventListener("close", () => opener?.focus());
  }
</script>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-l) var(--space-m);
  }

  figure {
    display: grid;
    gap: var(--space-xs);
  }

  .frame {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius-sm) var(--radius-tile);
    background: var(--color-subtle);
  }

  .photo {
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: scale 300ms ease;
  }

  .zoom {
    position: absolute;
    inset-block-end: var(--space-s);
    inset-inline-end: var(--space-s);
    display: grid;
    place-items: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.92);
    opacity: 0;
    transition: opacity 200ms ease;
  }

  .zoom::before {
    content: "";
    inline-size: 0.875rem;
    block-size: 0.875rem;
    border: 2px solid var(--color-ink);
    border-radius: 50%;
  }

  .frame:hover .photo {
    scale: 1.03;
  }

  .frame:hover .zoom,
  .frame:focus-visible .zoom {
    opacity: 1;
  }

  figcaption {
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  @media (width >= 48rem) {
    .gallery {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-xl) var(--space-l);
    }

    .compact {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>

<style is:global>
  .lightbox {
    inline-size: 100%;
    max-inline-size: 100%;
    block-size: 100%;
    max-block-size: 100%;
    margin: 0;
    padding: var(--space-xl) var(--space-m);
    border: 0;
    background: rgb(255 255 255 / 0.97);
    color: var(--color-ink);
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox-figure {
    display: grid;
    gap: var(--space-s);
    justify-items: center;
    max-inline-size: min(60rem, 100%);
  }

  .lightbox-image {
    max-block-size: calc(100dvh - 9rem);
    inline-size: auto;
    max-inline-size: 100%;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-card);
  }

  .lightbox-caption {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
    justify-content: center;
    max-inline-size: 48rem;
    font-size: var(--text-sm);
    text-align: center;
  }

  .lightbox-counter {
    color: var(--color-accent);
    font-family: var(--font-mono);
  }

  .lightbox-button {
    position: absolute;
    display: grid;
    place-items: center;
    inline-size: var(--target-size);
    block-size: var(--target-size);
    border: 0;
    border-radius: 50%;
    background: var(--color-subtle);
    color: var(--color-ink);
    cursor: pointer;
  }

  .lightbox-button:hover {
    background: var(--color-line);
  }

  .lightbox-button svg {
    inline-size: 1.375rem;
    block-size: 1.375rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .lightbox-close {
    inset-block-start: var(--space-s);
    inset-inline-end: var(--space-s);
  }

  .lightbox-prev,
  .lightbox-next {
    inset-block-start: 50%;
    translate: 0 -50%;
  }

  .lightbox-prev {
    inset-inline-start: var(--space-s);
  }

  .lightbox-next {
    inset-inline-end: var(--space-s);
  }
</style>
