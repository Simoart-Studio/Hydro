---
import { Image } from "astro:assets";
import { hero } from "../content/hero";
import Button from "./Button.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <Image
    class="backdrop"
    src={hero.image.src}
    alt={hero.image.alt}
    widths={[640, 1024, 1600, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="content">
    <h1 id="hero-title">{hero.title}</h1>
    <p class="label">{hero.label}</p>
    <Button href={hero.action.href} arrow>
      {hero.action.label}
    </Button>
  </div>
</section>

<style>
  /* The hero sits on a picture in both themes, so its colours are fixed rather than themed. */
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-block-size: clamp(22rem, 18rem + 18vw, 34rem);
    padding: var(--space-2xl) var(--gutter) calc(var(--space-2xl) + var(--hero-overlap));
    overflow: hidden;
    background: #9fb4c4;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 70% 65% at 50% 45%,
      rgb(15 30 36 / 0.62),
      rgb(15 30 36 / 0.2)
    );
  }

  .backdrop {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 60% 50%;
  }

  .content {
    position: relative;
    display: grid;
    gap: var(--space-m);
    justify-items: center;
    max-inline-size: 44rem;
    text-align: center;
  }

  h1 {
    color: #ffffff;
    text-shadow: 0 2px 16px rgb(15 30 36 / 0.45);
  }

  .label {
    margin-block-end: var(--space-xs);
    padding: var(--space-2xs) var(--space-m);
    border-radius: var(--radius-sm);
    background: #ffffff;
    color: #c8452a;
    font-weight: 600;
  }
</style>
