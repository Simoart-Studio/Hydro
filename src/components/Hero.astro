---
import { Image } from "astro:assets";
import { hero } from "../content/hero";
import { site } from "../content/site";
import BoilerRoomDiagram from "./BoilerRoomDiagram.astro";
import Button from "./Button.astro";
import Container from "./Container.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <Container class="layout">
    <div class="copy">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-title">{hero.title}</h1>
      <p class="lead">{hero.lead}</p>
      <div class="actions">
        <Button href={hero.primaryAction.href}>{hero.primaryAction.label}</Button>
        <Button variant="outline" href={hero.secondaryAction.href}>
          {hero.secondaryAction.label}
        </Button>
      </div>
      <ul class="highlights" role="list">
        {hero.highlights.map((highlight) => (
          <li>{highlight}</li>
        ))}
      </ul>
    </div>
    {site.heroImage ? (
      <Image
        class="photo"
        src={site.heroImage.src}
        alt={site.heroImage.alt}
        widths={[480, 720, 960, 1200]}
        sizes="(min-width: 60rem) 36rem, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    ) : (
      <BoilerRoomDiagram />
    )}
  </Container>
</section>

<style>
  .hero {
    --color-ink: var(--color-hero-fg);
    --color-muted: var(--color-hero-muted);
    --color-heat: var(--color-hero-heat);
    --color-cool: var(--color-hero-cool);
    --color-on-heat: var(--color-hero-on-heat);

    padding-block: var(--space-2xl) calc(var(--space-2xl) + var(--hero-overlap));
    background: var(--color-hero-bg);
    color: var(--color-ink);
  }

  .layout {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }

  .copy {
    display: grid;
    gap: var(--space-l);
    min-inline-size: 0;
  }

  .eyebrow {
    color: var(--color-heat);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .lead {
    max-inline-size: var(--measure);
    color: var(--color-muted);
    font-size: var(--text-lg);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  .highlights {
    display: grid;
    gap: var(--space-xs);
  }

  .highlights li {
    display: flex;
    gap: var(--space-s);
    align-items: baseline;
  }

  .highlights li::before {
    content: "";
    flex: none;
    inline-size: 1.25rem;
    block-size: 3px;
    border-radius: var(--radius-sm);
    background: linear-gradient(90deg, var(--color-heat) 50%, var(--color-cool) 50%);
    translate: 0 -0.3em;
  }

  .photo {
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--radius-lg) 0;
  }

  @media (width >= 60rem) {
    .layout {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
  }
</style>
