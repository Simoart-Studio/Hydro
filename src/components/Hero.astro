---
import { Image } from "astro:assets";
import { hero } from "../content/hero";
import Button from "./Button.astro";
import Container from "./Container.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="media">
    <Image
      class="photo"
      src={hero.image.src}
      alt={hero.image.alt}
      widths={[640, 960, 1200]}
      sizes="(min-width: 56rem) 62vw, 100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <Container class="inner">
    <div class="content">
      <p class="label">{hero.label}</p>
      <h1 id="hero-title">
        {hero.title} <span class="accent">{hero.titleAccent}</span>
      </h1>
      <p class="lead">{hero.lead}</p>
      <div class="actions">
        <Button href={hero.action.href} arrow>
          {hero.action.label}
        </Button>
        <a class="secondary" href={hero.secondaryAction.href}>
          {hero.secondaryAction.label}
        </a>
      </div>
    </div>
  </Container>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    padding-block-end: var(--hero-overlap);
    overflow: hidden;
    background: var(--color-hero-bg);
  }

  .media {
    position: relative;
    aspect-ratio: 16 / 10;
  }

  .media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 55%, var(--color-hero-bg));
  }

  .photo {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }

  .inner {
    position: relative;
  }

  .content {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
    max-inline-size: 34rem;
    padding-block: var(--space-m) var(--space-2xl);
  }

  .label {
    color: var(--color-blue);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  h1 {
    color: var(--color-ink);
  }

  .accent {
    color: var(--color-accent);
  }

  .lead {
    color: var(--color-muted);
    font-size: var(--text-lg);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-l);
    align-items: center;
    margin-block-start: var(--space-xs);
  }

  .secondary {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-size);
    color: var(--color-blue);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.3em;
  }

  .secondary:hover {
    color: var(--color-navy);
  }

  @media (width >= 56rem) {
    .hero {
      min-block-size: clamp(28rem, 18rem + 18vw, 38rem);
      align-items: center;
    }

    .media {
      position: absolute;
      inset-block: 0;
      inset-inline-end: 0;
      inline-size: 62%;
      aspect-ratio: auto;
    }

    .media::after {
      background: linear-gradient(to right, var(--color-hero-bg), transparent 32%);
    }

    .content {
      max-inline-size: min(32rem, 40%);
      padding-block: var(--space-2xl);
    }
  }
</style>
