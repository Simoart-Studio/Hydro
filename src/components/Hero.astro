---
import { Image } from "astro:assets";
import { hero } from "../content/hero";
import Button from "./Button.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <Image
    class="backdrop"
    src={hero.image.src}
    alt={hero.image.alt}
    widths={[640, 960, 1200]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="content">
    <h1 id="hero-title">{hero.title}</h1>
    <p class="label">{hero.label}</p>
    <Button href={hero.action.href} arrow>
      {hero.action.label}
    </Button>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-block-size: clamp(22rem, 16rem + 18vw, 34rem);
    padding: var(--space-2xl) var(--gutter) calc(var(--space-2xl) + var(--hero-overlap));
    overflow: hidden;
    background: var(--color-subtle);
  }

  .backdrop {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }

  .content {
    position: relative;
    display: grid;
    gap: var(--space-m);
    justify-items: center;
    max-inline-size: 38rem;
    padding: var(--space-l) var(--space-xl);
    border-block-start: 4px solid var(--color-coral-strong);
    background: rgb(255 255 255 / 0.97);
    box-shadow: var(--shadow-card);
    text-align: center;
  }

  h1 {
    color: var(--color-ink);
  }

  .label {
    margin-block-end: var(--space-xs);
    color: var(--color-coral-strong);
    font-size: var(--text-sm);
    font-weight: 600;
  }
</style>
