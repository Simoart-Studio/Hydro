---
import { Image } from "astro:assets";
import { hero } from "../content/hero";
import Button from "./Button.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <Image
    class="backdrop"
    src={hero.image.src}
    alt={hero.image.alt}
    widths={[640, 1024, 1600, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="content">
    <h1 id="hero-title">{hero.title}</h1>
    <p class="label">{hero.label}</p>
    <Button href={hero.action.href} arrow>
      {hero.action.label}
    </Button>
  </div>
</section>

<style>
  /* The drawing behind the hero is light in both themes, so the hero keeps light-theme colours. */
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-block-size: clamp(18rem, 14rem + 14vw, 28rem);
    padding: var(--space-2xl) var(--gutter) calc(var(--space-2xl) + var(--hero-overlap));
    overflow: hidden;
    background: #f3f5f6;
  }

  .backdrop {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 60% 50%;
  }

  .content {
    position: relative;
    display: grid;
    gap: var(--space-m);
    justify-items: center;
    max-inline-size: 38rem;
    text-align: center;
  }

  h1 {
    color: #1f2d33;
  }

  .label {
    margin-block-end: var(--space-xs);
    padding: var(--space-2xs) var(--space-m);
    border: 1px solid #e2e3ea;
    background: #ffffff;
    color: #c8452a;
    font-size: var(--text-sm);
    font-weight: 600;
  }
</style>
