---
interface Props {
  width?: "page" | "column";
  class?: string;
}

const { width = "page", class: className } = Astro.props;
---

<div class:list={["container", width, className]}>
  <slot />
</div>

<style>
  .container {
    inline-size: 100%;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .page {
    max-inline-size: calc(var(--width-page) + 2 * var(--gutter));
  }

  .column {
    max-inline-size: calc(var(--width-column) + 2 * var(--gutter));
  }
</style>
