---
interface Props {
  size?: number;
}

const { size = 32 } = Astro.props;
---

<svg class="logo" viewBox="0 0 40 40" width={size} height={size} aria-hidden="true">
  <path class="connector" d="M27 11v18"></path>
  <path class="supply" d="M6 11h28"></path>
  <path class="return" d="M6 29h28"></path>
</svg>

<style>
  .logo {
    flex: none;
    fill: none;
    stroke-linecap: round;
    stroke-width: 5;
  }

  .connector {
    stroke: var(--color-petrol-fg);
  }

  .supply {
    stroke: var(--color-coral);
  }

  .return {
    stroke: var(--color-petrol-fg);
    opacity: 0.55;
  }
</style>
