---
import { Image } from "astro:assets";
import logoMark from "../assets/brand/logo-mark.png";

interface Props {
  size?: number;
}

const { size = 44 } = Astro.props;
---

<Image class="logo" src={logoMark} alt="" width={size} height={size} densities={[1, 2]} />

<style>
  .logo {
    flex: none;
    border-radius: var(--radius-sm);
  }
</style>
