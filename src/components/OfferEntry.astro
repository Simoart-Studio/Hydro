---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { offerPage } from "../content/offer";
import Button from "./Button.astro";

interface Props {
  id: string;
  title: string;
  summary: string;
  scope: string[];
  image: ImageMetadata;
  alt: string;
  reverse?: boolean;
}

const { id, title, summary, scope, image, alt, reverse = false } = Astro.props;
const titleId = `${id}-title`;
---

<article id={id} class:list={["entry", { reverse }]} aria-labelledby={titleId}>
  <Image
    class="image"
    src={image}
    alt={alt}
    widths={[320, 480, 720]}
    sizes="(min-width: 48rem) 22rem, 90vw"
  />
  <div class="body">
    <h2 id={titleId}>{title}</h2>
    <p>{summary}</p>
    <h3>{offerPage.scopeLabel}</h3>
    <ul class="scope" role="list">
      {scope.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
    <Button href="/kontakt" size="small" arrow class="inquiry">
      {offerPage.inquiryLabel}
      <span class="visually-hidden">: {title}</span>
    </Button>
  </div>
</article>

<style>
  .entry {
    display: grid;
    gap: var(--space-l);
    align-items: center;
    padding-block: var(--space-2xl);
    border-block-end: 1px solid var(--color-line);
    scroll-margin-block-start: var(--space-m);
  }

  .image {
    inline-size: 100%;
    max-inline-size: 24rem;
    block-size: auto;
    justify-self: center;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm) var(--radius-tile);
  }

  .body {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
  }

  h2 {
    color: var(--color-coral-strong);
  }

  h3 {
    margin-block-start: var(--space-xs);
    color: var(--color-petrol);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .scope {
    display: grid;
    gap: var(--space-2xs);
    inline-size: 100%;
    border-block-start: 1px solid var(--color-line);
  }

  .scope li {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: var(--space-xs);
    padding-block: var(--space-xs);
    border-block-end: 1px solid var(--color-line);
  }

  .scope li::before {
    content: "+";
    color: var(--color-coral-strong);
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .inquiry {
    margin-block-start: var(--space-s);
  }

  @media (width >= 48rem) {
    .entry {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: var(--space-2xl);
    }

    .reverse .image {
      order: 1;
    }
  }
</style>
