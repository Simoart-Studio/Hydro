---
const description =
  "Schemat kotłowni. Pompa ciepła lub kocioł podgrzewa wodę w zasobniku CWU i w buforze ciepła. Z bufora woda zasilająca o temperaturze około 55 °C płynie do ogrzewania budynku i wraca do bufora chłodniejsza, około 45 °C.";

const pipes = [
  { kind: "supply", path: "M176 92H88" },
  { kind: "return", path: "M88 172h88" },
  { kind: "supply", path: "M288 92h76" },
  { kind: "return", path: "M364 172h-76" },
  { kind: "supply", path: "M440 72h22v192" },
  { kind: "return", path: "M402 264v-48" },
];

const arrows = [
  "M126 92l8-4v8z",
  "M138 172l-8-4v8z",
  "M332 92l-8-4v8z",
  "M320 172l8-4v8z",
  "M462 176l-4-8h8z",
  "M402 234l-4 8h8z",
];
---

<figure class="diagram">
  <svg viewBox="0 0 488 352" role="img" aria-label={description}>
    <defs>
      <linearGradient id="boiler-tank-fill" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0.5" class="warm-stop"></stop>
        <stop offset="0.5" class="cool-stop"></stop>
      </linearGradient>
      <linearGradient
        id="boiler-coil"
        gradientUnits="userSpaceOnUse"
        x1="0"
        y1="92"
        x2="0"
        y2="172"
      >
        <stop offset="0" class="heat-stop"></stop>
        <stop offset="1" class="cool-stop-strong"></stop>
      </linearGradient>
    </defs>

    <text class="name" x="50" y="24">
      Zasobnik CWU
    </text>
    <rect class="tank" x="12" y="40" width="76" height="176" rx="26"></rect>
    <path class="coil" d="M88 92H36l28 16-28 16 28 16-28 16v16h52"></path>

    <rect class="block" x="176" y="56" width="112" height="144" rx="10"></rect>
    <path
      class="flame"
      transform="translate(232 104)"
      d="M0-16c7 7 11 12 11 19a11 11 0 0 1-22 0c0-5 3-9 6-12 0 4 2 6 4 6 0-5-2-9 1-13z"
    ></path>
    <text class="name" x="232" y="152">
      Pompa ciepła
    </text>
    <text class="name" x="232" y="172">
      lub kocioł
    </text>

    <text class="name" x="402" y="24">
      Bufor ciepła
    </text>
    <rect class="tank" x="364" y="40" width="76" height="176" rx="26"></rect>

    <rect class="block" x="12" y="264" width="464" height="76" rx="10"></rect>
    <text class="name start" x="28" y="308">
      Ogrzewanie budynku
    </text>
    <path class="loop" d="M462 264v60H250v-32h152v-28"></path>

    <text class="value supply-text" x="326" y="62">
      zasilanie
    </text>
    <text class="value supply-text" x="326" y="78">
      55 °C
    </text>
    <text class="value return-text" x="326" y="196">
      powrót
    </text>
    <text class="value return-text" x="326" y="212">
      45 °C
    </text>

    {pipes.map((pipe) => (
      <path class:list={["pipe", pipe.kind]} d={pipe.path} />
    ))}
    {pipes.map((pipe) => (
      <path class="flow" d={pipe.path} />
    ))}
    {arrows.map((arrow) => (
      <path class="arrow" d={arrow} />
    ))}
  </svg>
  <ul class="legend" role="list">
    <li>
      <span class="swatch supply"></span>zasilanie
    </li>
    <li>
      <span class="swatch return"></span>powrót
    </li>
  </ul>
  <figcaption>Schemat poglądowy, temperatury przykładowe.</figcaption>
</figure>

<style>
  .diagram {
    --diagram-line: color-mix(in srgb, var(--color-hero-fg) 45%, transparent);
    --diagram-fill: color-mix(in srgb, var(--color-hero-fg) 6%, transparent);

    display: grid;
    gap: var(--space-s);
    color: var(--color-hero-fg);
  }

  svg {
    inline-size: 100%;
    block-size: auto;
    overflow: visible;
  }

  .warm-stop {
    stop-color: color-mix(in srgb, var(--color-hero-heat) 30%, var(--color-hero-bg));
  }

  .cool-stop {
    stop-color: color-mix(in srgb, var(--color-hero-cool) 24%, var(--color-hero-bg));
  }

  .heat-stop {
    stop-color: var(--color-hero-heat);
  }

  .cool-stop-strong {
    stop-color: var(--color-hero-cool);
  }

  .tank {
    fill: url(#boiler-tank-fill);
    stroke: var(--diagram-line);
    stroke-width: 1.5;
  }

  .block {
    fill: var(--diagram-fill);
    stroke: var(--diagram-line);
    stroke-width: 1.5;
  }

  .coil {
    fill: none;
    stroke: url(#boiler-coil);
    stroke-linejoin: round;
    stroke-width: 3;
  }

  .flame {
    fill: var(--color-hero-heat);
  }

  .loop {
    fill: none;
    stroke: var(--diagram-line);
    stroke-linejoin: round;
    stroke-width: 3;
  }

  .name {
    fill: currentColor;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    text-anchor: middle;
  }

  .start {
    text-anchor: start;
  }

  .value {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    text-anchor: middle;
  }

  .supply-text {
    fill: var(--color-hero-heat);
  }

  .return-text {
    fill: var(--color-hero-cool);
  }

  .pipe {
    fill: none;
    stroke-linejoin: round;
    stroke-width: 8;
  }

  .pipe.supply {
    stroke: var(--color-hero-heat);
  }

  .pipe.return {
    stroke: var(--color-hero-cool);
  }

  .flow {
    fill: none;
    stroke: color-mix(in srgb, var(--color-hero-fg) 75%, transparent);
    stroke-dasharray: 2 12;
    stroke-linecap: round;
    stroke-width: 2;
  }

  .arrow {
    fill: var(--color-hero-bg);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-l);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .legend li {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
  }

  .swatch {
    inline-size: 1.5rem;
    block-size: 0.375rem;
    border-radius: var(--radius-sm);
  }

  .swatch.supply {
    background: var(--color-hero-heat);
  }

  .swatch.return {
    background: var(--color-hero-cool);
  }

  figcaption {
    color: var(--color-hero-muted);
    font-size: var(--text-sm);
  }

  @media (prefers-reduced-motion: no-preference) {
    .flow {
      animation: flow 1.4s linear infinite;
    }
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -14;
    }
  }
</style>
