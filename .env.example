# Adres produkcyjny strony, bez ukośnika na końcu. Używany w canonical, sitemap i Open Graph.
PUBLIC_SITE_URL=https://pompykotly.pl

# Adres usługi formularzy (np. https://formspree.io/f/xxxxxxx). Pusty = strona Kontakt pokazuje telefony zamiast formularza.
PUBLIC_FORM_ENDPOINT=

# true = meta robots noindex i blokada w robots.txt.
PUBLIC_NOINDEX=true
