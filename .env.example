# Adres strony bez ukośnika na końcu, używany w canonical, sitemapie, Open Graph i danych strukturalnych.
# Pusty: na Vercel brana jest domena produkcyjna projektu (dziś *.vercel.app, po podpięciu domeny klienta — ona),
# lokalnie http://localhost:4321. Ustaw jawnie, jeśli strona ma wskazywać inny adres.
PUBLIC_SITE_URL=

# Adres usługi formularzy (np. https://formspree.io/f/xxxxxxx). Pusty = formularz jest widoczny, ale nie wysyła:
# po poprawnym wypełnieniu informuje, że zgłoszenia przyjmujemy telefonicznie.
# Jego domena trafia automatycznie do Content-Security-Policy (connect-src, form-action).
PUBLIC_FORM_ENDPOINT=

# false = strona Kontakt pokazuje karty z telefonami zamiast formularza.
PUBLIC_CONTACT_FORM=

# Indeksowanie przez wyszukiwarki. Domyślnie wyłączone (meta robots noindex i blokada w robots.txt).
# Ustaw false dopiero na produkcji z domeną klienta i zatwierdzoną treścią.
PUBLIC_NOINDEX=true
